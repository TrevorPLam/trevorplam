{
  "name": "trevor-lam-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "check": "astro check",
    "security:scan": "node scripts/security-scan.mjs",
    "analyze:bundle": "ANALYZE=true npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y/",
    "test:unit": "vitest run tests/unit/",
    "test:mutation": "node scripts/run-mutation-tests.mjs",
    "test:browser": "vitest run tests/browser/ --project=browser",
    "test:contract": "vitest run tests/contract/",
    "test:property": "vitest run tests/property/",
    "test:fuzz": "npx jazzer tests/fuzzing/",
    "test:ai": "node tests/ai/run-ai-generated-tests.mjs",
    "test:full": "npm run test && npm run test:e2e && npm run test:a11y",
    "lighthouse": "lhci autorun",
    "lighthouse:healthcheck": "lhci healthcheck --fatal",
    "performance:collect": "node scripts/performance-monitor-simple.mjs collect",
    "performance:analyze": "node scripts/performance-monitor-simple.mjs analyze",
    "performance:report": "node scripts/performance-monitor-simple.mjs report",
    "performance:full": "node scripts/performance-monitor-simple.mjs full",
    "test:enterprise": "node scripts/test-orchestrator.mjs run --config=config/enterprise-test-config.json",
    "monitoring:start": "node tests/monitoring/realtime-manager.mjs",
    "monitoring:dashboard": "node tests/monitoring/realtime-dashboard.ts",
    "monitoring:demo": "node -e \"import('./tests/monitoring/realtime-manager.ts').then(m => new m.RealtimeMonitoringManager({autoStartDemo: true}).start()).catch(console.error)\"",
    "monitoring:complete": "npm run monitoring:start && npm run monitoring:dashboard && npm run performance:full",
    "bootstrap": "./scripts/bootstrap.sh",
    "sync": "./scripts/sync.sh",
    "doctor": "./scripts/doctor.sh",
    "env:audit": "./scripts/health/env-audit.sh",
    "quality-gate": "./scripts/quality-gate.sh",
    "test:pyramid": "./scripts/test-pyramid.sh",
    "ci": "./scripts/ci/pipeline.sh",
    "status": "./scripts/status.sh",
    "clean": "./scripts/clean.sh",
    "deps": "./scripts/deps-health.sh",
    "standup": "./scripts/standup.sh",
    "pr:describe": "./scripts/pr-description.sh",
    "release:preview": "./scripts/release/changelog-preview.sh",
    "rollback": "./scripts/rollback.sh",
    "backup": "./scripts/backup.sh",
    "ai:validate": "node scripts/ai/validate.js",
    "ai:context": "node scripts/ai/generate-context.js",
    "ai:brief": "./scripts/ai/task-handoff.sh",
    "ai:compress": "node scripts/ai/compress-repo.js",
    "ai:regression": "vitest run scripts/ai/regression.test.ts",
    "mookme:init": "node scripts/monorepo/mookme-init.js",
    "turbo:pipeline": "node scripts/monorepo/turbo-pipeline.js",
    "swarm": "./scripts/monorepo/swarm-run.sh",
    "bash-nuke": "./scripts/ops/bash-nuke.sh",
    "timewarp": "./scripts/ops/timewarp.sh",
    "simulate": "./scripts/ops/simulate-deploy.sh",
    "gitops": "./scripts/ops/gitops-sync.sh",
    "cycle-hunter": "./scripts/cycle-hunter.sh",
    "pulse": "node scripts/health/pulse.js",
    "oracle": "./scripts/bash-oracle.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@csstools/css-parser-algorithms": "^4.0.0",
    "@csstools/css-tokenizer": "^4.0.0",
    "@tailwindcss/vite": "^4.2.3",
    "astro": "^6.1.8",
    "astro-pagefind": "^1.8.6",
    "chart.js": "^4.5.1",
    "get-tsconfig": "^4.14.0",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@faker-js/faker": "^9.0.3",
    "@jazzer.js/core": "^4.0.0",
    "@jazzer.js/fuzzer": "^4.0.0",
    "@lhci/cli": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pact-foundation/pact": "^16.3.0",
    "@playwright/test": "^1.51.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
