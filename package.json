    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-browser-security": "^1.2.3",
    "eslint-plugin-secure-coding": "^3.1.3",
    "fast-check": "^4.7.0",
    "happy-dom": "^20.9.0",
    "ioredis": "^5.3.2",
    "json": "^11.0.0",
    "lefthook": "^2.1.6",
    "license-checker": "^25.0.1",
    "ml-matrix": "^6.10.9",
    "ml-regression": "^6.0.1",
    "node-fetch": "^3.3.2",
    "pagedjs-cli": "^0.4.3",
    "pg": "^8.11.3",
    "playwright": "^1.51.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-statistics": "^7.8.3",
    "socket.io": "^4.7.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.5",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "tmp": "^0.2.3"
  }
}
