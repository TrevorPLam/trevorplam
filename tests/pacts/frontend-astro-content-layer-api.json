    {
      "description": "a request for case studies content",
      "providerStates": [
        {
          "name": "case studies content is available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/content/case-studies"
      },
      "response": {
        "body": [
          {
            "data": {
              "industry": "QSR",
              "metric": "45% increase in online orders",
              "problem": "Grandlux needed to modernize their digital ordering system",
              "result": "Increased online orders by 45% and reduced wait times",
              "skills": [
                "Digital Strategy"
              ],
              "title": "Grandlux QSR Digital Transformation"
            },
            "id": "grandlux",
            "slug": "grandlux"
          }
        ],
        "headers": {
          "Access-Control-Allow-Headers": "Content-Type, Authorization",
          "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
          "Access-Control-Allow-Origin": "*",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].data.industry": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "QSR|Salon|CPA-Payroll"
                }
              ]
            },
            "$[*].data.metric": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].data.problem": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].data.result": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].data.skills": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].data.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
