#!/usr/bin/env node

/**
 * pre_write_code hook
 * Runs Astro type checking before code writes
 * Blocks the write if type checking fails (exit code 2)
 * Skips type checking for .windsurf/ directory (markdown files)
 */

import { execSync } from 'child_process';
import fs from 'fs';

function main() {
  try {
    // Read JSON input from stdin
    const input = fs.readFileSync(0, 'utf-8');
    const data = JSON.parse(input);

    const agentActionName = data.agent_action_name;
    const toolInfo = data.tool_info || {};
    const filePath = toolInfo.file_path;

    console.error(`[pre_write_code] Validating: ${filePath}`);

    // Skip type checking for .windsurf/ directory (markdown files don't need TypeScript validation)
    if (filePath && filePath.includes('.windsurf/')) {
      console.error('[pre_write_code] Skipping type check for .windsurf/ file');
      process.exit(0);
    }

    // Run astro check
    try {
      execSync('npm run check', { 
        stdio: 'inherit',
        cwd: process.cwd()
      });
      console.error('[pre_write_code] Type check passed');
      process.exit(0);
    } catch (error) {
      console.error('[pre_write_code] Type check failed - blocking write');
      console.error('[pre_write_code] Run "npm run check" manually to see errors');
      process.exit(2); // Exit code 2 blocks the action
    }
  } catch (error) {
    console.error('[pre_write_code] Error processing input:', error.message);
    process.exit(1);
  }
}

main();
