---
interface Props {
  name: string;
  value: string;
  context: string;
}

const { name, value, context } = Astro.props;
---

<div class="kpi-card @container">
  <div class="bg-surface border border-border rounded-lg p-4 h-full">
    <div class="space-y-2">
      <h3 class="text-sm font-medium text-text-body/70">{name}</h3>
      <p class="text-2xl font-bold text-text-heading">{value}</p>
      <p class="text-xs text-text-body/60">{context}</p>
    </div>
  </div>

  <style>
    .kpi-card {
      container-type: inline-size;
    }
    
    @container (min-width: 200px) {
      .kpi-card h3 {
        font-size: 0.875rem;
        line-height: 1.25rem;
      }
      .kpi-card p:first-of-type {
        font-size: 1.5rem;
        line-height: 2rem;
      }
      .kpi-card p:last-of-type {
        font-size: 0.75rem;
        line-height: 1rem;
      }
    }
    
    @container (min-width: 300px) {
      .kpi-card h3 {
        font-size: 0.875rem;
        line-height: 1.25rem;
      }
      .kpi-card p:first-of-type {
        font-size: 1.875rem;
        line-height: 2.25rem;
      }
      .kpi-card p:last-of-type {
        font-size: 0.875rem;
        line-height: 1.25rem;
      }
    }
    
    @container (min-width: 400px) {
      .kpi-card h3 {
        font-size: 1rem;
        line-height: 1.5rem;
      }
      .kpi-card p:first-of-type {
        font-size: 2.25rem;
        line-height: 2.5rem;
      }
      .kpi-card p:last-of-type {
        font-size: 1rem;
        line-height: 1.5rem;
      }
    }
  </style>
