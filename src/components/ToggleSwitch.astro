---
interface Props {
  label: string;
  checked?: boolean;
}

const { label, checked: initialChecked = false } = Astro.props;
---

<button
  type="button"
  role="switch"
  aria-checked={initialChecked}
  aria-label={label}
  class="relative inline-flex h-6 w-11 items-center rounded-full bg-border transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-bg min-h-[44px] min-w-[44px]"
  data-toggle-switch
  data-initial-checked={initialChecked}
>
  <span class="sr-only">{label}</span>
  <span
    class={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${
      initialChecked ? 'translate-x-6' : 'translate-x-1'
    }`}
  ></span>
</button>

<script>
  // Find the toggle button and initialize if found
  const button = document.querySelector('[data-toggle-switch]') as HTMLButtonElement | null;
  if (button) {
    // Get initial state from data attribute
    const initialChecked = button.getAttribute('data-initial-checked') === 'true';
    let isChecked = initialChecked;

    // Handle click events
    button.addEventListener('click', () => {
      isChecked = !isChecked;
      button.setAttribute('aria-checked', isChecked.toString());

      // Update visual state
      const span = button.querySelector('span:last-child');
      if (span) {
        if (isChecked) {
          span.classList.remove('translate-x-1');
          span.classList.add('translate-x-6');
        } else {
          span.classList.remove('translate-x-6');
          span.classList.add('translate-x-1');
        }
      }

      // Call external callback if provided
      if (typeof window !== 'undefined' && window.onToggleChange) {
        window.onToggleChange(isChecked);
      }
    });

    // Handle keyboard events (Space key)
    button.addEventListener('keydown', (event) => {
      if (event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        button.click();
      }
    });

    // Expose current state
    if (typeof window !== 'undefined') {
      window.getToggleState = () => isChecked;
      window.setToggleState = (value) => {
        isChecked = value;
        button.setAttribute('aria-checked', isChecked.toString());
        const span = button.querySelector('span:last-child');
        if (span) {
          if (isChecked) {
            span.classList.remove('translate-x-1');
            span.classList.add('translate-x-6');
          } else {
            span.classList.remove('translate-x-6');
            span.classList.add('translate-x-1');
          }
        }
      };
    }
  }
</script>
