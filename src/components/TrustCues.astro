---
interface Props {
  lastUpdated?: Date;
  verified?: boolean;
  downloadUrl?: string;
  slug?: string;
  className?: string;
}

const { lastUpdated, verified = true, downloadUrl, slug, className = '' } = Astro.props;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<div class={`trust-cues ${className}`}>
  <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
    {lastUpdated && (
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Last updated: {formatDate(lastUpdated)}</span>
      </div>
    )}
    
    {verified && (
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-green-600 font-medium">Case verified</span>
      </div>
    )}
    
    {slug && (
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <button 
          id="generate-pdf-btn"
          class="text-blue-600 hover:text-blue-800 transition-colors font-medium"
          onclick={`generatePDF('${slug}')`}
          disabled
        >
          Generate PDF
        </button>
        <span id="pdf-status" class="text-xs text-gray-500 hidden"></span>
      </div>
    )}
    
    {slug && (
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <a 
          href={`/pdfs/${slug}.pdf`} 
          class="text-blue-600 hover:text-blue-800 transition-colors"
          download
        >
          Download PDF
        </a>
      </div>
    )}
  </div>
</div>

{slug && (
  <script>
    async function generatePDF(slug: string) {
      const btn = document.getElementById('generate-pdf-btn') as HTMLButtonElement;
      const status = document.getElementById('pdf-status') as HTMLSpanElement;
      
      if (!btn || !status) return;
      
      btn.disabled = true;
      btn.textContent = 'Generating...';
      status.textContent = 'This may take 30-60 seconds';
      status.classList.remove('hidden');
      
      try {
        const response = await fetch('/api/generate-pdf', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ slug }),
        });
        
        if (response.ok) {
          const result = await response.json();
          if (result.success) {
            status.textContent = 'PDF generated successfully!';
            setTimeout(() => {
              window.location.href = `/pdfs/${slug}.pdf`;
            }, 1000);
          } else {
            throw new Error(result.error || 'Generation failed');
          }
        } else {
          throw new Error('Server error');
        }
      } catch (error: any) {
        status.textContent = `Error: ${error.message}`;
        btn.textContent = 'Retry';
        btn.disabled = false;
      }
    }
    
    // Enable button when page loads
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('generate-pdf-btn') as HTMLButtonElement;
      if (btn) btn.disabled = false;
    });
  </script>
)}

<style>
  .trust-cues {
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }
</style>
