---
// Footer component with copyright and availability statement
import AnalyticsToggle from './AnalyticsToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<footer role="contentinfo" class="bg-surface border-t border-border mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center">
      <p class="text-text-body text-sm">
        © {new Date().getFullYear()} Trevor Lam. All rights reserved.
      </p>
      <p class="text-text-body text-sm mt-2">
        Available for Operations, Chief of Staff, and HR/Payroll opportunities.
      </p>
      <div class="mt-4 flex justify-center space-x-6">
        <a 
          href="https://linkedin.com/in/trevor-lam" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-text-body hover:text-text-heading transition-colors"
          aria-label="LinkedIn profile"
        >
          LinkedIn
        </a>
        <a 
          href="mailto:trevor@trevor-lam.com" 
          class="text-text-body hover:text-text-heading transition-colors"
          aria-label="Email contact"
        >
          Email
        </a>
      </div>
      <div class="mt-4 flex justify-center space-x-6 text-sm">
        <a 
          href="/privacy" 
          class="text-text-body hover:text-text-heading transition-colors"
          aria-label="Privacy Policy"
        >
          Privacy Policy
        </a>
        <a 
          href="/terms" 
          class="text-text-body hover:text-text-heading transition-colors"
          aria-label="Terms of Use"
        >
          Terms of Use
        </a>
      </div>
      <div class="mt-6 flex justify-center gap-4">
        <ThemeToggle />
        <AnalyticsToggle />
      </div>
    </div>
  </div>
</footer>
