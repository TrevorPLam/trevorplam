---
interface Props {
  title: string;
  message: string;
  icon?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const { 
  title, 
  message, 
  icon, 
  ctaText, 
  ctaHref, 
  secondaryCtaText, 
  secondaryCtaHref 
} = Astro.props;
---

<section class="text-center py-16" aria-labelledby="empty-state-heading">
  <div class="max-w-2xl mx-auto">
    {icon && (
      <div class="mb-6 flex justify-center" aria-hidden="true">
        <div set:html={icon} />
      </div>
    )}
    
    <h2 id="empty-state-heading" class="text-2xl font-bold text-text-heading mb-4">
      {title}
    </h2>
    
    <p class="text-text-body mb-8">
      {message}
    </p>
    
    {(ctaText || secondaryCtaText) && (
      <div class="flex justify-center gap-4 flex-wrap">
        {ctaText && ctaHref && (
          <a 
            href={ctaHref}
            class="inline-flex items-center gap-2 bg-accent text-accent-text rounded-lg hover:bg-accent/90 transition-colors min-h-[44px] px-6 py-3 font-medium"
          >
            {ctaText}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        )}
        
        {secondaryCtaText && secondaryCtaHref && (
          <a 
            href={secondaryCtaHref}
            class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-6 py-3 rounded-lg transition-colors min-h-[44px]"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    )}
  </div>
</section>
