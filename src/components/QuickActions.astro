---
import { navigationConfig } from '../config/navigation';

// Get primary navigation actions for dashboard
const primaryActions = navigationConfig.main.filter(item => item.slug !== 'dashboard').slice(0, 4);

function getActionIcon(slug: string): string {
  switch (slug) {
    case 'capabilities':
      return 'briefcase';
    case 'cases':
      return 'document-text';
    case 'lab':
      return 'beaker';
    case 'resources':
      return 'book-open';
    case 'archive':
      return 'archive';
    default:
      return 'circle';
  }
}

function getActionColor(slug: string): string {
  switch (slug) {
    case 'capabilities':
      return 'bg-blue-100 text-blue-600 hover:bg-blue-200';
    case 'cases':
      return 'bg-emerald-100 text-emerald-600 hover:bg-emerald-200';
    case 'lab':
      return 'bg-purple-100 text-purple-600 hover:bg-purple-200';
    case 'resources':
      return 'bg-amber-100 text-amber-600 hover:bg-amber-200';
    case 'archive':
      return 'bg-slate-100 text-slate-600 hover:bg-slate-200';
    default:
      return 'bg-surface text-text-heading hover:bg-accent/20';
  }
}
---

<section class="mb-8">
  <h2 class="text-2xl font-bold text-text-heading mb-6">Quick Actions</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {primaryActions.map((action) => (
      <a 
        href={action.href}
        class="group bg-surface border border-border rounded-lg p-6 hover:shadow-lg hover:border-accent/50 transition-all duration-200 flex items-center space-x-4"
      >
        <div class={`shrink-0 w-12 h-12 rounded-lg ${getActionColor(action.slug)} flex items-center justify-center transition-colors duration-200`}>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {action.slug === 'capabilities' && (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 13.255A8.999 8.999 0 0112 21a8.999 8.999 0 01-9-7.745M12 3a8.999 8.999 0 019 7.745M12 3v9m0 0l-3-3m3 3l3-3" />
            )}
            {action.slug === 'cases' && (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            )}
            {action.slug === 'lab' && (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            )}
            {action.slug === 'resources' && (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            )}
            {action.slug === 'archive' && (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            )}
          </svg>
        </div>
        
        <div class="flex-1 min-w-0">
          <h3 class="text-lg font-semibold text-text-heading group-hover:text-accent transition-colors duration-200">
            {action.name}
          </h3>
          <p class="text-sm text-text-body/80 mt-1">
            {action.children && action.children.length > 0 
              ? `${action.children.length} sections available`
              : 'Explore content'
            }
          </p>
        </div>
        
        <div class="shrink-0">
          <svg class="w-5 h-5 text-text-body/50 group-hover:text-text-heading group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>
    ))}
  </div>
  
  <div class="mt-6 p-4 bg-accent/10 border border-accent/30 rounded-lg">
    <div class="flex items-center space-x-3">
      <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
      <p class="text-sm text-accent">
        <strong>Tip:</strong> Use the sidebar navigation to explore all sections and subsections.
      </p>
    </div>
  </div>
</section>
