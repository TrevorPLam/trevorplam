---
interface Props {
  placeholder?: string;
  className?: string;
  autofocus?: boolean;
}

const {
  placeholder = "Search case studies, learning logs, and resources…",
  className = "",
  autofocus = false
} = Astro.props;
---

<div class={`relative ${className}`} id="search-container">
  <form action="/search" method="get" class="relative">
    <input
      type="search"
      name="q"
      id="site-search"
      class="w-full px-4 py-2 pl-10 bg-surface border border-border rounded-md text-text-heading placeholder-text-body/50 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent min-h-[44px]"
      placeholder={placeholder}
      autofocus={autofocus}
      value={Astro.url.searchParams.get('q') || ''}
      aria-label="Search site"
    />
    <button
      type="submit"
      class="sr-only"
      aria-label="Submit search"
    >
      Search
    </button>
  </form>

  <!-- Search Icon -->
  <svg
    class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-text-body/50 pointer-events-none"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>

  <!-- Keyboard shortcut hint -->
  <div class="keyboard-hint" aria-hidden="true">⌘K</div>
</div>

<style>
  /* Keyboard shortcut hint */
  .keyboard-hint {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.75rem;
    color: var(--color-text-body);
    opacity: 0.7;
    pointer-events: none;
  }

  #site-search:focus ~ .keyboard-hint {
    opacity: 0;
  }
</style>

<script>
  // Global keyboard shortcut for search (Cmd+K / Ctrl+K)
  function setupKeyboardShortcut() {
    document.addEventListener('keydown', (event) => {
      // Check for Cmd+K (Mac) or Ctrl+K (Windows/Linux)
      if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
        event.preventDefault();
        const searchInput = document.querySelector('#site-search');
        if (searchInput && searchInput instanceof HTMLInputElement) {
          searchInput.focus();
          searchInput.select();
        }
      }
    });
  }

  // Setup keyboard shortcut when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupKeyboardShortcut);
  } else {
    setupKeyboardShortcut();
  }

  // Cleanup event listeners before swap to prevent memory leaks
  document.addEventListener('astro:before-swap', () => {
    document.removeEventListener('keydown', setupKeyboardShortcut);
  }, { once: true });
</script>
