---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Impact - Trevor Lam" 
  description="Quantified results and narrative case studies demonstrating operational excellence across payroll, compliance, and financial operations."
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header with Toggle -->
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-text-heading mb-4">
        Impact
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Quantified results and narrative case studies demonstrating operational excellence across three industries.
      </p>
      
      <!-- Page Content -->
      <div class="text-center">
        <p class="text-text-body max-w-3xl mx-auto">
          Impact page content is being updated. Please check back later for complete case studies and performance metrics.
        </p>
      </div>
    </header>

    <!-- Content Areas -->
    <main>
      <div class="text-center py-12">
        <h2 class="text-2xl font-semibold text-text-heading mb-4">
          Impact Page
        </h2>
        <p class="text-text-body max-w-3xl mx-auto">
          This page is being updated. Please check back later for the complete impact and case studies showcase.
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
