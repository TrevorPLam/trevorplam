---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHeader from '../../components/CaseStudyHeader.astro';
import InlineMetric from '../../components/InlineMetric.astro';
import SkillTag from '../../components/SkillTag.astro';
import TrustCues from '../../components/TrustCues.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  
  return caseStudies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get all case studies for navigation
const allCaseStudies = await getCollection('caseStudies');
const currentIndex = allCaseStudies.findIndex(study => study.id === entry.id);
const previousCase = currentIndex > 0 ? allCaseStudies[currentIndex - 1] : null;
const nextCase = currentIndex < allCaseStudies.length - 1 ? allCaseStudies[currentIndex + 1] : null;

// Get related capabilities for this case study
const capabilities = await getCollection('capabilities');
const relatedCapabilities = capabilities.filter(cap => 
  entry.data.relatedCases.includes(cap.data.slug)
);

// BreadcrumbList schema for this case study
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://trevor-lam.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Case Studies',
      item: 'https://trevor-lam.com/cases'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.industry,
      item: `https://trevor-lam.com/cases?industry=${entry.data.industry}`
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: entry.data.title,
      item: `https://trevor-lam.com/cases/${entry.id}`
    }
  ]
};

const pageJsonLd = {
  '@type': 'Article',
  '@id': `https://trevor-lam.com/cases/${entry.id}#article`,
  headline: entry.data.title,
  description: `${entry.data.problem} ${entry.data.result}`,
  author: { '@id': 'https://trevor-lam.com/#person' },
  mainEntityOfPage: `https://trevor-lam.com/cases/${entry.id}`,
  about: entry.data.industry,
  dateModified: entry.data.lastUpdated?.toISOString(),
  datePublished: entry.data.lastUpdated?.toISOString()
};
---

<BaseLayout 
  title={entry.data.title} 
  description={`${entry.data.problem} ${entry.data.result}`}
  ogType="article"
  jsonLd={[breadcrumbJsonLd, pageJsonLd]}
>
  <div class="flex">
    <div class="flex-1 ml-64">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <Breadcrumbs />
        
        <article>
          <CaseStudyHeader 
            title={entry.data.title}
            industry={entry.data.industry}
          />
          
          {entry.data.pdfUrl && (
            <div class="mb-6">
              <a 
                href={entry.data.pdfUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-accent text-white px-4 py-2 rounded-lg hover:bg-accent/90 transition-colors min-h-[44px] min-w-[44px]"
                aria-label="Download PDF version of this case study"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Download PDF
              </a>
            </div>
          )}
          
          <TrustCues 
            lastUpdated={entry.data.lastUpdated}
            verified={true}
            slug={entry.id}
          />

          <Content />

          {relatedCapabilities.length > 0 && (
            <section class="mt-16 pt-8 border-t border-border">
              <h2 class="text-2xl font-semibold mb-6">Related Capabilities</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {relatedCapabilities.map(capability => (
                  <a 
                    href={`/capabilities/${capability.data.slug}`}
                    class="block p-4 border border-border rounded-lg hover:bg-accent hover:text-white transition-colors"
                  >
                    <h3 class="font-semibold mb-2">{capability.data.title}</h3>
                    <p class="text-sm text-text-muted line-clamp-2">{capability.data.philosophy}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

          <nav class="mt-16 pt-8 border-t border-border">
            <div class="flex justify-between items-center">
              {previousCase && (
                <a 
                  href={`/cases/${previousCase.id}`}
                  class="flex items-center gap-2 text-accent hover:text-text-heading transition-colors"
                >
                  ← Previous: {previousCase.data.title}
                </a>
              )}
              
              <div class="flex-1"></div>
              
              {nextCase && (
                <a 
                  href={`/cases/${nextCase.id}`}
                  class="flex items-center gap-2 text-accent hover:text-text-heading transition-colors text-right"
                >
                  Next: {nextCase.data.title} →
                </a>
              )}
            </div>
          </nav>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>
