---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Timestamp from '../components/Timestamp.astro';
---

<BaseLayout 
	title="Terms of Use - Trevor Lam" 
	description="Terms of use for Trevor Lam's portfolio site."
	excludeAnalytics={true}
>
	<div class="max-w-3xl mx-auto">
		<Breadcrumbs />
		<h1 class="text-4xl font-bold text-text-heading mb-8">Terms of Use</h1>
		
		<p class="text-text-body mb-6">
			Last updated: <Timestamp date="2026-04-22" format="medium" showIcon={false} />
		</p>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Agreement to Terms</h2>
			<p class="text-text-body mb-4">
				By accessing and using Trevor Lam's portfolio site ("the Site"), you agree to be bound by these Terms of Use. 
				If you do not agree to these terms, please do not use this Site.
			</p>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Intellectual Property</h2>
			<p class="text-text-body mb-4">
				All content on this Site, including text, graphics, logos, images, and software, is the property of Trevor Lam or its content suppliers and is protected by copyright and other intellectual property laws.
			</p>
			<p class="text-text-body mb-4">
				You may not:
			</p>
			<ul class="list-disc list-inside text-text-body mb-4 space-y-2">
				<li>Modify, copy, distribute, transmit, display, perform, reproduce, publish, license, create derivative works from, transfer, or sell any information obtained from this Site</li>
				<li>Use this Site for any commercial purpose without express written consent</li>
			</ul>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Acceptable Use</h2>
			<p class="text-text-body mb-4">
				You agree to use this Site only for lawful purposes. You agree not to:
			</p>
			<ul class="list-disc list-inside text-text-body mb-4 space-y-2">
				<li>Use the Site in any way that violates applicable laws or regulations</li>
				<li>Use the Site to transmit or distribute malicious software or code</li>
				<li>Attempt to gain unauthorized access to any part of the Site</li>
				<li>Interfere with or disrupt the Site or servers connected to the Site</li>
				<li>Use the Site to harass, abuse, or harm others</li>
			</ul>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">User Contributions</h2>
			<p class="text-text-body mb-4">
				When you submit information through the contact form, you represent and warrant that:
			</p>
			<ul class="list-disc list-inside text-text-body mb-4 space-y-2">
				<li>You have the right to submit the information</li>
				<li>The information does not violate the rights of any third party</li>
				<li>The information is accurate and not misleading</li>
			</ul>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Disclaimer</h2>
			<p class="text-text-body mb-4">
				The materials on this Site are provided "as is" without any express or implied warranties. 
				Trevor Lam makes no representations or warranties of any kind, express or implied, regarding the operation of this Site or the information, content, materials, or products included on this Site.
			</p>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Limitation of Liability</h2>
			<p class="text-text-body mb-4">
				In no event shall Trevor Lam be liable for any damages arising out of the use or inability to use this Site, 
				even if Trevor Lam has been advised of the possibility of such damages.
			</p>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Governing Law</h2>
			<p class="text-text-body mb-4">
				These terms shall be governed by and construed in accordance with the laws of the jurisdiction in which Trevor Lam resides, 
				without regard to its conflict of law provisions.
			</p>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Changes to Terms</h2>
			<p class="text-text-body mb-4">
				Trevor Lam reserves the right to modify these terms at any time. Continued use of the Site after changes constitutes acceptance of the modified terms.
			</p>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold text-text-heading mb-4">Contact</h2>
			<p class="text-text-body mb-4">
				If you have questions about these Terms of Use, please contact:
			</p>
			<p class="text-text-body mb-4">
				Email: <a href="mailto:trevor@trevor-lam.com" class="text-accent hover:underline">trevor@trevor-lam.com</a>
			</p>
		</section>
	</div>
</BaseLayout>
