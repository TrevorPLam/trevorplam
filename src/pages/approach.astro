---
import BaseLayout from '../layouts/BaseLayout.astro';

// JSON-LD Schema for DefinedTerm concepts
const operationsApproachSchema = {
	"@context": "https://schema.org",
	"@type": "DefinedTerm",
	"@id": "#operations-approach",
	"termCode": "OA-001",
	"name": "Operations Diagnosis & Rebuild",
	"description": "A practical framework for identifying operational friction, prioritizing improvements by impact, and building scalable systems that work.",
	"inDefinedTermSet": "Operational Methodology"
};

const informationSystemsSchema = {
	"@context": "https://schema.org",
	"@type": "DefinedTerm", 
	"@id": "#information-systems",
	"termCode": "IS-001",
	"name": "Information Systems Design",
	"description": "Building systems that make organizational knowledge visible and usable—so teams can actually find what they need and act on it.",
	"inDefinedTermSet": "Operational Methodology"
};

const definedTermSchemas = [operationsApproachSchema, informationSystemsSchema];
---

<BaseLayout 
	title="My Approach" 
	description="How I diagnose operational friction, prioritize high-impact improvements, and build scalable systems that prevent recurrence."
	jsonLd={definedTermSchemas}
>
	
	<section class="py-20 px-6" aria-labelledby="approach-heading">
		<div class="max-w-4xl mx-auto">
			<header class="text-center mb-16">
				<h1 id="approach-heading" class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
					My Approach
				</h1>
				<p class="text-xl text-text-body max-w-3xl mx-auto leading-relaxed">
					I don't just apply quick fixes—I identify the root cause of operational friction and build scalable systems that prevent recurrence. Same approach, three industries, consistent results.
				</p>
			</header>

			<!-- Three-Phase Approach -->
			<section class="mb-20" aria-labelledby="phases-heading">
				<h2 id="phases-heading" class="text-3xl font-bold text-text-heading mb-8">
					My Three-Phase Approach
				</h2>
				
				<div class="space-y-8">
					<div class="bg-surface/50 border border-border rounded-lg p-8">
						<h3 class="text-xl font-semibold text-text-heading mb-4">Phase 1: Diagnose the Core Friction</h3>
						<p class="text-text-body leading-relaxed mb-4">
							Before I recommend any change, I trace where information actually flows—and where it stalls. Operational inefficiencies leave clear signals in data, documentation, and team feedback. I map existing workflows, identify friction points, and quantify their impact on accuracy, compliance, and efficiency.
						</p>
						<ul class="text-text-body space-y-2 list-disc list-inside">
							<li>Map existing information flows and control points</li>
							<li>Identify friction points and their frequency</li>
							<li>Quantify impact in terms of accuracy, compliance, and efficiency</li>
							<li>Document stakeholder pain points and business risks</li>
						</ul>
					</div>

					<div class="bg-surface/50 border border-border rounded-lg p-8">
						<h3 class="text-xl font-semibold text-text-heading mb-4">Phase 2: Prioritize by Impact</h3>
						<p class="text-text-body leading-relaxed mb-4">
							Not all problems are equal. I focus on fixes that have the biggest ripple effect—
							what breaks other things, what costs the most, what's blocking the team right now.
						</p>
						<ul class="text-text-body space-y-2 list-disc list-inside">
							<li>Calculate cost of inaction vs. implementation effort</li>
							<li>Identify cascade effects across departments</li>
							<li>Assess compliance and legal exposure</li>
							<li>Evaluate team capacity and change readiness</li>
						</ul>
					</div>

					<div class="bg-surface/50 border border-border rounded-lg p-8">
						<h3 class="text-xl font-semibold text-text-heading mb-4">Phase 3: Build Scalable Systems</h3>
						<p class="text-text-body leading-relaxed mb-4">
							Once priorities are clear, I design systems with proper controls and automation that prevent errors instead of just catching them after the fact. The goal is infrastructure that scales with the organization, reduces manual oversight, and empowers teams with reliable information.
						</p>
						<ul class="text-text-body space-y-2 list-disc list-inside">
							<li>Design controlled information environments with proper validation</li>
							<li>Implement automation for routine processes and compliance checks</li>
							<li>Create documentation and training that scales with the organization</li>
							<li>Establish monitoring systems that detect issues before they become crises</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Information Architecture Meta-Skill -->
			<section class="mb-20" aria-labelledby="info-arch-heading">
				<h2 id="info-arch-heading" class="text-3xl font-bold text-text-heading mb-8">
					Why Information Flow Matters
				</h2>
				
				<div class="prose prose-invert max-w-none">
					<p class="text-text-body text-lg leading-relaxed mb-6">
						Most operational friction isn't a process problem—it's an information problem. When teams can't find what they need, can't track what's happening, or work from inconsistent data, everything slows down. I build systems that ensure information is accessible, accurate, and actionable across the organization.
					</p>
					
					<p class="text-text-body leading-relaxed mb-6">
						When payroll fails, the immediate problem is incorrect calculations. The root 
						cause is usually that information isn't flowing right: inconsistent employee data, 
						unclear approval workflows, or disconnected systems that can't talk to each other. 
						I address the root cause to prevent recurrence.
						Fixing the calculation is temporary; optimizing the information flow is permanent.
					</p>

					<div class="bg-surface/30 border-l-4 border-teal rounded-r-lg p-6 my-8">
						<h3 class="text-xl font-semibold text-text-heading mb-3">Core Principles</h3>
						<ul class="text-text-body space-y-3">
							<li><strong>Single Source of Truth:</strong> Every piece of data has one authoritative source and clear ownership</li>
							<li><strong>Controlled Access:</strong> Information flows through validated pathways with proper checks and balances</li>
							<li><strong>Auditability:</strong> Every change is tracked, timestamped, and attributable to specific actions</li>
							<li><strong>Scalability:</strong> Systems grow with the organization without requiring complete redesigns</li>
						</ul>
					</div>

					<p class="text-text-body leading-relaxed mb-6">
						I've used this approach across fast food (Sonic), salons (Grandlux), and 
						professional services (KLW)—with completely different operational challenges. 
						The industry changes, but the principles stay the same.
					</p>
				</div>
			</section>

			<!-- Evidence and Case Studies -->
			<section class="mb-20" aria-labelledby="evidence-heading">
				<h2 id="evidence-heading" class="text-3xl font-bold text-text-heading mb-8">
					The Results
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
					<a 
						href="/cases/sonic" 
						class="block bg-surface/50 border border-border rounded-lg p-6 hover:border-teal/50 transition-colors duration-200"
					>
						<h3 class="text-lg font-semibold text-text-heading mb-2">Sonic Drive-in</h3>
						<p class="text-text-body text-sm">
							Unit optimization: $1.4M to $1.7M revenue, food cost 2.7% to 0.75%, turnover 175%+ to under 80%
						</p>
					</a>
					
					<a 
						href="/cases/klw" 
						class="block bg-surface/50 border border-border rounded-lg p-6 hover:border-teal/50 transition-colors duration-200"
					>
						<h3 class="text-lg font-semibold text-text-heading mb-2">KLW Financial Group</h3>
						<p class="text-text-body text-sm">
							Promoted to Integrator (#2 role) in 18 months, managed 315+ payroll accounts across 3 entities
						</p>
					</a>
					
					<a 
						href="/cases/grandlux" 
						class="block bg-surface/50 border border-border rounded-lg p-6 hover:border-teal/50 transition-colors duration-200"
					>
						<h3 class="text-lg font-semibold text-text-heading mb-2">Grandlux Nail Salon</h3>
						<p class="text-text-body text-sm">
							Zero cash discrepancies across all reconciliations, proactive service recovery
						</p>
					</a>
				</div>

				<div class="text-center">
					<a 
						href="/impact" 
						class="inline-flex items-center gap-2 bg-teal text-bg px-6 py-3 rounded-lg font-medium hover:bg-teal/90 transition-colors duration-200 min-h-[44px] min-w-[44px] focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 focus:ring-offset-bg"
					>
						View Complete Impact
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</section>
		</div>
	</section>
</BaseLayout>
