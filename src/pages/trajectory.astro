---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
---

<BaseLayout 
  title="Career Journey - Trevor Lam" 
  description="Complete career journey from 2008 to 2027, showcasing operational excellence across Sonic Drive-in, Grandlux Restaurant Group, Kelly Lombardi & Associates, and future readiness."
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Career Journey
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        From Sonic carhop to running operations for three companies. Here's how I got here—and where I'm headed.
      </p>
    </header>

    <!-- Timeline -->
    <section class="mb-16" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="sr-only">Interactive Timeline</h2>
      <Timeline />
    </section>

    <!-- Constraint Period Explanation -->
    <section class="bg-surface rounded-lg p-8 border border-border" aria-labelledby="constraint-heading">
      <h2 id="constraint-heading" class="text-2xl font-bold text-text-heading mb-4">
        Building Credentials for the Next Step
      </h2>
      <p class="text-text-body leading-relaxed">
        April 2026 to March 2027 isn't a gap—it's time I'm using to document my case studies and 
        formalize credentials for senior operations roles. The timeline is clear and the work is in progress.
      </p>
    </section>
  </div>
</BaseLayout>
