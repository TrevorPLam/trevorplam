---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get all skills data
const skills = await getCollection('skills');

// Group skills by category
const skillsByCategory = skills.reduce((acc, skill) => {
  const category = skill.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category] = acc[category].concat(skill.data.skills);
  return acc;
}, {} as Record<string, any[]>);

// Flatten all skills for overall stats
const allSkills = skills.flatMap(skill => skill.data.skills);
const totalSkills = allSkills.length;

// Calculate proficiency distribution
const proficiencyCounts = allSkills.reduce((acc, skill) => {
  acc[skill.level] = (acc[skill.level] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<BaseLayout 
  title="Skills Matrix - Resources - Trevor Lam" 
  description="Comprehensive overview of technical and leadership capabilities with proficiency levels and experience."
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Skills Matrix
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Comprehensive overview of technical and leadership capabilities with proficiency levels and experience.
        This matrix shows exactly what I bring to operations and leadership roles.
      </p>
      <div class="flex justify-center gap-4 text-sm text-text-muted">
        <span class="bg-surface border border-border rounded px-3 py-1">
          {totalSkills} Skills Total
        </span>
        <span class="bg-surface border border-border rounded px-3 py-1">
          {Object.keys(skillsByCategory).length} Categories
        </span>
      </div>
    </header>

    <!-- Proficiency Overview -->
    <section class="mb-16" aria-labelledby="proficiency-heading">
      <h2 id="proficiency-heading" class="text-2xl font-bold text-text-heading mb-8">
        Proficiency Distribution
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-surface border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-green-600 dark:text-green-400 mb-2">
            {proficiencyCounts['expert'] || 0}
          </div>
          <div class="text-sm font-medium text-text-heading">Expert</div>
          <div class="text-xs text-text-muted">10+ years experience</div>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2">
            {proficiencyCounts['advanced'] || 0}
          </div>
          <div class="text-sm font-medium text-text-heading">Advanced</div>
          <div class="text-xs text-text-muted">5-10 years experience</div>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-yellow-600 dark:text-yellow-400 mb-2">
            {proficiencyCounts['intermediate'] || 0}
          </div>
          <div class="text-sm font-medium text-text-heading">Intermediate</div>
          <div class="text-xs text-text-muted">2-5 years experience</div>
        </div>
        <div class="bg-surface border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-gray-600 dark:text-gray-400 mb-2">
            {proficiencyCounts['beginner'] || 0}
          </div>
          <div class="text-sm font-medium text-text-heading">Beginner</div>
          <div class="text-xs text-text-muted">0-2 years experience</div>
        </div>
      </div>
    </section>

    <!-- Skills by Category -->
    {skills.length > 0 ? (
      <section class="mb-16" aria-labelledby="categories-heading">
        <h2 id="categories-heading" class="text-2xl font-bold text-text-heading mb-8">
          Skills by Category
        </h2>
        
        {Object.entries(skillsByCategory).map(([category, categorySkills]) => (
          <div class="mb-12" key={category}>
            <h3 class="text-xl font-semibold text-text-heading mb-6">{category}</h3>
            <div class="bg-surface border border-border rounded-lg overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead class="bg-surface/50 border-b border-border">
                    <tr>
                      <th class="text-left px-6 py-4 text-sm font-semibold text-text-heading">Skill</th>
                      <th class="text-left px-6 py-4 text-sm font-semibold text-text-heading">Proficiency</th>
                      <th class="text-left px-6 py-4 text-sm font-semibold text-text-heading">Experience</th>
                      <th class="text-left px-6 py-4 text-sm font-semibold text-text-heading">Certifications</th>
                    </tr>
                  </thead>
                  <tbody>
                    {categorySkills.map((skill, index) => (
                      <tr class={`border-b border-border ${index % 2 === 0 ? 'bg-surface/25' : ''}`} key={skill.name}>
                        <td class="px-6 py-4">
                          <div class="font-medium text-text-heading">{skill.name}</div>
                        </td>
                        <td class="px-6 py-4">
                          <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium ${
                            skill.level === 'expert' 
                              ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400'
                              : skill.level === 'advanced'
                              ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                              : skill.level === 'intermediate'
                              ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400'
                              : 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400'
                          }`}>
                            {skill.level.charAt(0).toUpperCase() + skill.level.slice(1)}
                          </span>
                        </td>
                        <td class="px-6 py-4">
                          <div class="text-sm text-text-body">
                            {skill.yearsExperience} {skill.yearsExperience === 1 ? 'year' : 'years'}
                          </div>
                        </td>
                        <td class="px-6 py-4">
                          {skill.certifications && skill.certifications.length > 0 ? (
                            <div class="flex flex-wrap gap-1">
                              {skill.certifications.map((cert: string) => (
                                <span class="text-xs bg-accent/10 text-accent-text px-2 py-1 rounded border border-accent/20">
                                  {cert}
                                </span>
                              ))}
                            </div>
                          ) : (
                            <span class="text-sm text-text-muted">None</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        ))}
      </section>
    ) : (
      <section class="text-center py-16">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-text-heading mb-4">
            Skills Matrix Coming Soon
          </h2>
          <p class="text-text-body mb-8">
            I'm currently cataloging my technical and leadership skills across different domains. 
            This will include proficiency levels, years of experience, and relevant certifications.
          </p>
          <div class="flex justify-center gap-4">
            <a 
              href="/connect" 
              class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors"
            >
              Get Notified
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
            <a 
              href="/resources" 
              class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-6 py-3 rounded-lg transition-colors"
            >
              View All Resources
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mb-16" aria-label="Resource navigation">
      <div class="flex justify-between items-center bg-surface border border-border rounded-lg p-6">
        <a 
          href="/resources" 
          class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Resources
        </a>
        
        <div class="flex gap-4">
          <a 
            href="/resources/playbooks" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Playbooks
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <a 
            href="/resources/templates" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Templates
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <!-- Trust Cues -->
    <section class="bg-surface/50 border border-border rounded-lg p-8 mt-16">
      <h2 class="text-xl font-bold text-text-heading mb-6 text-center">
        Why This Skills Matrix Matters
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-teal mb-3">Transparent Capabilities</h3>
          <p class="text-text-body text-sm">
            Clear visibility into exactly what skills and experience levels I bring to your organization.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Verified Expertise</h3>
          <p class="text-text-body text-sm">
            Skills are backed by years of experience and relevant certifications where applicable.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Continuous Growth</h3>
          <p class="text-text-body text-sm">
            This matrix evolves as I develop new capabilities and deepen existing expertise.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
