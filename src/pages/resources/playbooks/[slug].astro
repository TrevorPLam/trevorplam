---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SidebarNavigation from '../../../components/SidebarNavigation.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Timestamp from '../../../components/Timestamp.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  const playbooks = resources.filter(r => r.data.type === 'playbook');
  return playbooks.map((playbook) => ({
    params: { slug: playbook.data.slug },
    props: { playbook },
  }));
}

type Props = { playbook: CollectionEntry<'resources'> };

const { playbook } = Astro.props;
const { Content } = await render(playbook);

// BreadcrumbList schema for this playbook
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://trevor-lam.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Resources',
      item: 'https://trevor-lam.com/resources'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Playbooks',
      item: 'https://trevor-lam.com/resources/playbooks'
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: playbook.data.title,
      item: `https://trevor-lam.com/resources/playbooks/${playbook.data.slug}`
    }
  ]
};

const pageJsonLd = {
  '@type': 'Article',
  '@id': `https://trevor-lam.com/resources/playbooks/${playbook.data.slug}#article`,
  headline: playbook.data.title,
  description: playbook.data.description,
  author: { '@id': 'https://trevor-lam.com/#person' },
  mainEntityOfPage: `https://trevor-lam.com/resources/playbooks/${playbook.data.slug}`,
  about: `${playbook.data.type} for ${playbook.data.audience}`,
  dateModified: playbook.data.lastUpdated?.toISOString(),
  datePublished: playbook.data.lastUpdated?.toISOString()
};
---

<BaseLayout 
  title={`${playbook.data.title} - Playbooks - Resources - Trevor Lam`}
  description={`${playbook.data.description} - Step-by-step playbook for ${playbook.data.audience}.`}
  jsonLd={[breadcrumbJsonLd, pageJsonLd]}
>
  <div class="flex">
    <SidebarNavigation />
    <main class="flex-1 ml-64 p-6">
      <Breadcrumbs />
      <article class="max-w-4xl mx-auto">
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-sm px-3 py-1 bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400 rounded font-medium">
              Playbook
            </span>
            Updated: <Timestamp date={playbook.data.lastUpdated} format="medium" showIcon={false} />
            {playbook.data.gated && (
              <span class="text-sm px-3 py-1 bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 rounded font-medium">
                Gated Content
              </span>
            )}
          </div>
          <h1 class="text-4xl font-bold text-text-heading mb-4">{playbook.data.title}</h1>
          <p class="text-xl text-text-body leading-relaxed mb-4">{playbook.data.description}</p>
          <div class="text-sm text-text-body/70">
            <strong>Audience:</strong> {playbook.data.audience}
          </div>
        </header>

        {playbook.data.gated ? (
          <section class="bg-surface/50 border border-border rounded-lg p-8 text-center mb-8">
            <div class="max-w-2xl mx-auto">
              <h2 class="text-2xl font-bold text-text-heading mb-4">
                Premium Resource
              </h2>
              <p class="text-text-body mb-6">
                This playbook contains proprietary methodologies and detailed implementation guidance. 
                Available to clients and partners working directly with me.
              </p>
              <div class="flex justify-center gap-4">
                <a 
                  href="/connect" 
                  class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors"
                >
                  Request Access
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </section>
        ) : (
          <section class="prose prose-lg max-w-none">
            <Content />
          </section>
        )}

        <!-- Download Section -->
        {playbook.data.downloadUrl && !playbook.data.gated && (
          <section class="mt-12 pt-8 border-t border-border">
            <h2 class="text-2xl font-semibold mb-6 text-text-heading">Download This Playbook</h2>
            <div class="bg-surface/50 border border-border rounded-lg p-6">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-semibold text-text-heading mb-2">Ready-to-use Version</h3>
                  <p class="text-text-body text-sm">
                    Download this playbook as a formatted PDF for offline reference and sharing with your team.
                  </p>
                </div>
                <a 
                  href={playbook.data.downloadUrl}
                  download
                  class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors min-h-[44px] min-w-[44px]"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Download PDF
                </a>
              </div>
            </div>
          </section>
        )}

        <!-- Related Resources -->
        <section class="mt-12 pt-8 border-t border-border">
          <h2 class="text-2xl font-semibold mb-6 text-text-heading">More Resources</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a 
              href="/resources/templates" 
              class="block p-4 bg-surface border border-border rounded-lg hover:bg-accent/10 transition-colors"
            >
              <h3 class="font-medium text-text-heading mb-2">
                Templates
              </h3>
              <p class="text-sm text-text-body">Ready-to-use templates for immediate implementation</p>
            </a>
            <a 
              href="/resources/skills-matrix" 
              class="block p-4 bg-surface border border-border rounded-lg hover:bg-accent/10 transition-colors"
            >
              <h3 class="font-medium text-text-heading mb-2">
                Skills Matrix
              </h3>
              <p class="text-sm text-text-body">Comprehensive overview of capabilities and expertise</p>
            </a>
            <a 
              href="/capabilities" 
              class="block p-4 bg-surface border border-border rounded-lg hover:bg-accent/10 transition-colors"
            >
              <h3 class="font-medium text-text-heading mb-2">
                Capabilities
              </h3>
              <p class="text-sm text-text-body">Deep dive into core competencies and approaches</p>
            </a>
          </div>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>
