---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Get all playbook resources
const resources = await getCollection('resources');
const playbooks = resources.filter(r => r.data.type === 'playbook');

// Sort by last updated (newest first)
const sortedPlaybooks = playbooks.sort((a, b) => 
  new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime()
);
---

<BaseLayout 
  title="Playbooks - Resources - Trevor Lam" 
  description="Step-by-step guides for common operational challenges. From process optimization to team scaling."
  jsonLd={{
    '@type': 'ItemList',
    name: 'Operational Playbooks',
    description: 'Collection of step-by-step guides for operations management and leadership challenges.',
    numberOfItems: playbooks.length,
    itemListElement: playbooks.map((playbook, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: playbook.data.title,
      description: playbook.data.description,
      url: `${new URL(Astro.url.origin)}/resources/playbooks/${playbook.data.slug}`
    }))
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Playbooks
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Step-by-step guides for common operational challenges. From process optimization to team scaling.
        These are the exact approaches I've used to solve real business problems.
      </p>
      <div class="flex justify-center gap-4 text-sm text-text-muted">
        <span class="bg-surface border border-border rounded px-3 py-1">
          {playbooks.length} Playbooks Available
        </span>
      </div>
    </header>

    <!-- Playbooks Grid -->
    {sortedPlaybooks.length > 0 ? (
      <section class="mb-16" aria-labelledby="playbooks-heading">
        <h2 id="playbooks-heading" class="sr-only">All Playbooks</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPlaybooks.map((playbook) => (
            <article class="bg-surface border border-border rounded-lg p-6 hover:shadow-lg transition-shadow duration-300">
              <header class="mb-4">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-sm px-3 py-1 bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400 rounded font-medium">
                    Playbook
                  </span>
                  {playbook.data.gated && (
                    <span class="text-xs px-2 py-1 bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 rounded">
                      Gated
                    </span>
                  )}
                </div>
                <h3 class="text-xl font-bold text-text-heading mb-2">
                  <a 
                    href={`/resources/playbooks/${playbook.data.slug}`}
                    class="hover:text-teal transition-colors duration-200"
                  >
                    {playbook.data.title}
                  </a>
                </h3>
                <p class="text-sm text-text-body/70 line-clamp-3 mb-3">
                  {playbook.data.description}
                </p>
                <div class="text-xs text-text-muted mb-4">
                  <strong>Audience:</strong> {playbook.data.audience}
                </div>
              </header>

              <!-- Call to Action -->
              <div class="flex items-center justify-between">
                <a 
                  href={`/resources/playbooks/${playbook.data.slug}`}
                  class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-medium text-sm transition-colors duration-200"
                >
                  {playbook.data.gated ? 'Request Access' : 'View Playbook'}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
                
                <time class="text-xs text-text-body/50" datetime={playbook.data.lastUpdated.toISOString()}>
                  {playbook.data.lastUpdated.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </time>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="text-center py-16">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-text-heading mb-4">
            Playbooks Coming Soon
          </h2>
          <p class="text-text-body mb-8">
            I'm currently developing comprehensive playbooks for operational excellence. 
            These will include step-by-step guides for process optimization, team scaling, and systems implementation.
          </p>
          <div class="flex justify-center gap-4">
            <a 
              href="/connect" 
              class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors"
            >
              Get Notified
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
            <a 
              href="/resources" 
              class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-6 py-3 rounded-lg transition-colors"
            >
              View All Resources
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mb-16" aria-label="Resource navigation">
      <div class="flex justify-between items-center bg-surface border border-border rounded-lg p-6">
        <a 
          href="/resources" 
          class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Resources
        </a>
        
        <div class="flex gap-4">
          <a 
            href="/resources/templates" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Templates
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <a 
            href="/resources/skills-matrix" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Skills Matrix
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <!-- Trust Cues -->
    <section class="bg-surface/50 border border-border rounded-lg p-8 mt-16">
      <h2 class="text-xl font-bold text-text-heading mb-6 text-center">
        Why These Playbooks Work
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-teal mb-3">Battle-Tested</h3>
          <p class="text-text-body text-sm">
            Every playbook comes from real operational challenges I've solved across different industries and company sizes.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Step-by-Step</h3>
          <p class="text-text-body text-sm">
            Clear, actionable steps that you can follow immediately without guessing or ambiguity.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Measurable Results</h3>
          <p class="text-text-body text-sm">
            Each playbook includes success metrics and KPIs to track your implementation progress.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
