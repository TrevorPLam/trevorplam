---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Get all template resources
const resources = await getCollection('resources');
const templates = resources.filter(r => r.data.type === 'template');

// Sort by last updated (newest first)
const sortedTemplates = templates.sort((a, b) => 
  new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime()
);
---

<BaseLayout 
  title="Templates - Resources - Trevor Lam" 
  description="Downloadable templates for immediate use. Project plans, metrics dashboards, and process documents."
  jsonLd={{
    '@type': 'ItemList',
    name: 'Operational Templates',
    description: 'Collection of downloadable templates for immediate use in operations and project management.',
    numberOfItems: templates.length,
    itemListElement: templates.map((template, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: template.data.title,
      description: template.data.description,
      url: `${new URL(Astro.url.origin)}/resources/templates/${template.data.slug}`
    }))
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Templates
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Downloadable templates for immediate use. Project plans, metrics dashboards, and process documents.
        Ready-to-use formats that save you hours of setup time.
      </p>
      <div class="flex justify-center gap-4 text-sm text-text-muted">
        <span class="bg-surface border border-border rounded px-3 py-1">
          {templates.length} Templates Available
        </span>
      </div>
    </header>

    <!-- Templates Grid -->
    {sortedTemplates.length > 0 ? (
      <section class="mb-16" aria-labelledby="templates-heading">
        <h2 id="templates-heading" class="sr-only">All Templates</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedTemplates.map((template) => (
            <article class="bg-surface border border-border rounded-lg p-6 hover:shadow-lg transition-shadow duration-300">
              <header class="mb-4">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-sm px-3 py-1 bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 rounded font-medium">
                    Template
                  </span>
                  {template.data.gated && (
                    <span class="text-xs px-2 py-1 bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 rounded">
                      Gated
                    </span>
                  )}
                </div>
                <h3 class="text-xl font-bold text-text-heading mb-2">
                  <a 
                    href={`/resources/templates/${template.data.slug}`}
                    class="hover:text-teal transition-colors duration-200"
                  >
                    {template.data.title}
                  </a>
                </h3>
                <p class="text-sm text-text-body/70 line-clamp-3 mb-3">
                  {template.data.description}
                </p>
                <div class="text-xs text-text-muted mb-4">
                  <strong>Audience:</strong> {template.data.audience}
                </div>
              </header>

              <!-- Call to Action -->
              <div class="flex items-center justify-between">
                <a 
                  href={`/resources/templates/${template.data.slug}`}
                  class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-medium text-sm transition-colors duration-200"
                >
                  {template.data.gated ? 'Request Access' : 'View Template'}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
                
                <time class="text-xs text-text-body/50" datetime={template.data.lastUpdated.toISOString()}>
                  {template.data.lastUpdated.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short', 
                    day: 'numeric' 
                  })}
                </time>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="text-center py-16">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-text-heading mb-4">
            Templates Coming Soon
          </h2>
          <p class="text-text-body mb-8">
            I'm currently curating practical templates for operations professionals. 
            These will include project plans, metrics dashboards, process documents, and more.
          </p>
          <div class="flex justify-center gap-4">
            <a 
              href="/connect" 
              class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors"
            >
              Get Notified
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
            <a 
              href="/resources" 
              class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-6 py-3 rounded-lg transition-colors"
            >
              View All Resources
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mb-16" aria-label="Resource navigation">
      <div class="flex justify-between items-center bg-surface border border-border rounded-lg p-6">
        <a 
          href="/resources" 
          class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Resources
        </a>
        
        <div class="flex gap-4">
          <a 
            href="/resources/playbooks" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Playbooks
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <a 
            href="/resources/skills-matrix" 
            class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
          >
            Skills Matrix
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </nav>

    <!-- Trust Cues -->
    <section class="bg-surface/50 border border-border rounded-lg p-8 mt-16">
      <h2 class="text-xl font-bold text-text-heading mb-6 text-center">
        Why These Templates Work
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-teal mb-3">Battle-Tested</h3>
          <p class="text-text-body text-sm">
            Every template comes from real operational challenges I've solved across different industries and company sizes.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Ready-to-Use</h3>
          <p class="text-text-body text-sm">
            Plug-and-play formats that you can implement immediately without extensive customization.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Professional Standards</h3>
          <p class="text-text-body text-sm">
            Built using industry best practices and proven methodologies for consistent results.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
