---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Get resources and skills for display
const resources = await getCollection('resources');
const skills = await getCollection('skills');

// Group resources by type
const playbooks = resources.filter(r => r.data.type === 'playbook');
const templates = resources.filter(r => r.data.type === 'template');
const guides = resources.filter(r => r.data.type === 'guide');
const tools = resources.filter(r => r.data.type === 'tool');

// Sort by last updated (newest first)
const sortedResources = resources.sort((a, b) => 
  new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime()
);

// Get recent items for overview
const recentResources = sortedResources.slice(0, 6);
---

<BaseLayout 
  title="Resources - Trevor Lam" 
  description="Practical playbooks, downloadable templates, and comprehensive skills matrix for operations and leadership excellence."
  jsonLd={{
    '@type': 'ItemList',
    name: 'Professional Resources',
    description: 'Collection of practical tools, templates, and guides for operations management and leadership.',
    numberOfItems: resources.length,
    itemListElement: resources.map((resource, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: resource.data.title,
      description: resource.data.description,
      url: `${new URL(Astro.url.origin)}/resources/${resource.data.type === 'playbook' ? 'playbooks' : resource.data.type === 'template' ? 'templates' : 'guides'}/${resource.data.slug}`
    }))
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Resources
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Practical playbooks, downloadable templates, and comprehensive skills matrix for operations and leadership excellence.
        Everything I've learned and systematized, ready for you to use.
      </p>
      <div class="flex justify-center gap-4 text-sm text-text-muted">
        <span class="bg-surface border border-border rounded px-3 py-1">
          {playbooks.length} Playbooks
        </span>
        <span class="bg-surface border border-border rounded px-3 py-1">
          {templates.length} Templates
        </span>
        <span class="bg-surface border border-border rounded px-3 py-1">
          {skills.length} Skill Categories
        </span>
      </div>
    </header>

    <!-- Quick Navigation -->
    <nav class="mb-16" aria-label="Resource categories">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a 
          href="/resources/playbooks" 
          class="block bg-surface border border-border rounded-lg p-6 hover:border-teal transition-colors"
        >
          <h3 class="text-lg font-semibold text-text-heading mb-2">Playbooks</h3>
          <p class="text-text-body text-sm mb-4">
            Step-by-step guides for common operational challenges. From process optimization to team scaling.
          </p>
          <div class="flex items-center text-teal text-sm font-medium">
            View All Playbooks
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <a 
          href="/resources/templates" 
          class="block bg-surface border border-border rounded-lg p-6 hover:border-teal transition-colors"
        >
          <h3 class="text-lg font-semibold text-text-heading mb-2">Templates</h3>
          <p class="text-text-body text-sm mb-4">
            Downloadable templates for immediate use. Project plans, metrics dashboards, and process documents.
          </p>
          <div class="flex items-center text-teal text-sm font-medium">
            View All Templates
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <a 
          href="/resources/skills-matrix" 
          class="block bg-surface border border-border rounded-lg p-6 hover:border-teal transition-colors"
        >
          <h3 class="text-lg font-semibold text-text-heading mb-2">Skills Matrix</h3>
          <p class="text-text-body text-sm mb-4">
            Comprehensive overview of technical and leadership capabilities with proficiency levels and experience.
          </p>
          <div class="flex items-center text-teal text-sm font-medium">
            View Skills Matrix
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      </div>
    </nav>

    <!-- Recent Resources -->
    {recentResources.length > 0 && (
      <section class="mb-16" aria-labelledby="recent-resources-heading">
        <h2 id="recent-resources-heading" class="text-2xl font-bold text-text-heading mb-8">
          Recent Resources
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentResources.map((resource) => (
            <article class="bg-surface border border-border rounded-lg p-6">
              <div class="flex items-center justify-between mb-3">
                <span class={`text-xs px-2 py-1 rounded font-medium ${
                  resource.data.type === 'playbook' 
                    ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                    : resource.data.type === 'template'
                    ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400'
                    : resource.data.type === 'guide'
                    ? 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400'
                    : 'bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400'
                }`}>
                  {resource.data.type.charAt(0).toUpperCase() + resource.data.type.slice(1)}
                </span>
                <time class="text-sm text-text-muted" datetime={resource.data.lastUpdated.toISOString()}>
                  {resource.data.lastUpdated.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'short' 
                  })}
                </time>
              </div>
              <h3 class="text-lg font-semibold text-text-heading mb-3">
                <a 
                  href={`/resources/${resource.data.type === 'playbook' ? 'playbooks' : resource.data.type === 'template' ? 'templates' : 'guides'}/${resource.data.slug}`} 
                  class="hover:text-teal transition-colors"
                >
                  {resource.data.title}
                </a>
              </h3>
              <p class="text-text-body text-sm mb-4 line-clamp-3">
                {resource.data.description}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-text-muted">
                  For: {resource.data.audience}
                </span>
                {resource.data.gated && (
                  <span class="text-xs px-2 py-1 bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 rounded">
                    Gated
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>
        {resources.length > 6 && (
          <div class="text-center mt-8">
            <a 
              href="/resources/playbooks" 
              class="inline-flex items-center gap-2 text-teal hover:text-teal/80 font-medium"
            >
              View All {resources.length} Resources
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        )}
      </section>
    )}

    <!-- Empty State -->
    {resources.length === 0 && skills.length === 0 && (
      <section class="text-center py-16">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold text-text-heading mb-4">
            Building the Resource Library
          </h2>
          <p class="text-text-body mb-8">
            I'm currently curating and creating practical resources for operations professionals. 
            Soon this will be filled with playbooks, templates, and tools drawn from real-world experience.
          </p>
          <div class="flex justify-center gap-4">
            <a 
              href="/connect" 
              class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-6 py-3 rounded-lg transition-colors"
            >
              Get Notified
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
            <a 
              href="/capabilities" 
              class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-6 py-3 rounded-lg transition-colors"
            >
              View Capabilities
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Trust Cues -->
    <section class="bg-surface/50 border border-border rounded-lg p-8 mt-16">
      <h2 class="text-xl font-bold text-text-heading mb-6 text-center">
        Why I Share These Resources
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-semibold text-teal mb-3">Battle-Tested</h3>
          <p class="text-text-body text-sm">
            Every playbook and template comes from real operational challenges I've solved across different industries and company sizes.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Practical Application</h3>
          <p class="text-text-body text-sm">
            These aren't theoretical frameworks—they're actionable tools you can implement immediately to see results.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-teal mb-3">Continuous Improvement</h3>
          <p class="text-text-body text-sm">
            I update these resources based on feedback and new learnings, ensuring they stay relevant and effective.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
