---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Tech Stack - Trevor Lam" 
  description="Tools, technologies, and systems I use to build and optimize operations. Always evolving as I discover better solutions."
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Tech Stack
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Tools, technologies, and systems I use to build and optimize operations. 
        Always evolving as I discover better solutions.
      </p>
      <div class="bg-surface/50 border border-border rounded-lg p-6 max-w-2xl mx-auto">
        <p class="text-text-body text-sm">
          <strong class="text-text-heading">Philosophy:</strong> I prioritize tools that improve operational efficiency, 
          enable data-driven decisions, and scale with business growth. Technology serves the business strategy, 
          not the other way around.
        </p>
      </div>
    </header>

    <!-- Core Operations Stack -->
    <section class="mb-20" aria-labelledby="operations-heading">
      <h2 id="operations-heading" class="text-2xl font-bold text-text-heading mb-8">
        Core Operations Stack
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Financial Management -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Financial Management
          </h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium text-text-heading mb-2">Accounting & Payroll</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  QuickBooks Online (QBO)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Xero Bookkeeping
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  APEX Payroll (300+ accounts)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Thomson Reuters Tax
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-text-heading mb-2">Financial Controls</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Zero-discrepancy reconciliation
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Multi-entity accounting
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Month-end close automation
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- People Operations -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            People Operations
          </h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium text-text-heading mb-2">HR Systems</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Benefits Administration
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  ERISA & ACA Compliance
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Performance Management
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Retention Analytics
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-text-heading mb-2">Training & Development</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  AMLC Instructor Program
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  SOP Documentation
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Cross-functional training
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Business Operations -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Business Operations
          </h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium text-text-heading mb-2">Productivity & Office</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Microsoft 365 Suite
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Google Workspace
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Karbon Practice Management
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  SafeSend Document Exchange
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-text-heading mb-2">Communication</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Teams & Zoom
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Calendar Management
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Client Relationship Systems
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Marketing & Growth Stack -->
    <section class="mb-20" aria-labelledby="marketing-heading">
      <h2 id="marketing-heading" class="text-2xl font-bold text-text-heading mb-8">
        Marketing & Growth Stack
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Digital Marketing -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Digital Marketing
          </h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium text-text-heading mb-2">CRM & Marketing Automation</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  HubSpot CRM
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  ActiveCampaign
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Email Campaign Management
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-text-heading mb-2">Digital Advertising</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Google Ads Management
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Google Business Profile
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Search Console Analytics
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Analytics & Insights -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Analytics & Insights
          </h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium text-text-heading mb-2">Business Intelligence</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Excel Advanced (Pivot Tables, VLOOKUPs)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  KPI Dashboard Development
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Performance Analytics
                </li>
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-text-heading mb-2">Web Analytics</h4>
              <ul class="space-y-2 text-text-body text-sm">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Google Analytics 4
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Plausible Analytics (Privacy-first)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-teal rounded-full"></span>
                  Conversion Rate Optimization
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI & Productivity Stack -->
    <section class="mb-20" aria-labelledby="ai-heading">
      <h2 id="ai-heading" class="text-2xl font-bold text-text-heading mb-8">
        AI & Productivity Stack
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- AI Tools -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            AI Tools & Assistants
          </h3>
          <ul class="space-y-3 text-text-body text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">ChatGPT</strong> - Process documentation, analysis
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Claude</strong> - Complex reasoning, writing
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Perplexity</strong> - Research, fact-checking
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Gemini</strong> - Data analysis, insights
              </div>
            </li>
          </ul>
        </div>

        <!-- Development & Automation -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Development & Automation
          </h3>
          <ul class="space-y-3 text-text-body text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Astro</strong> - Static site generation
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Tailwind CSS</strong> - Rapid UI development
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">TypeScript</strong> - Type-safe development
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Zapier/Make</strong> - Workflow automation
              </div>
            </li>
          </ul>
        </div>

        <!-- Data & Analytics -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Data & Analytics
          </h3>
          <ul class="space-y-3 text-text-body text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Excel Advanced</strong> - 80 WPM, complex modeling
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">Power Query</strong> - Data transformation
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">SQL Basics</strong> - Database queries
              </div>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-teal rounded-full"></span>
              <div>
                <strong class="text-text-heading">API Integration</strong> - System connections
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Learning & Development Stack -->
    <section class="mb-20" aria-labelledby="learning-heading">
      <h2 id="learning-heading" class="text-2xl font-bold text-text-heading mb-8">
        Learning & Development Stack
      </h2>
      
      <div class="bg-surface/50 border border-border rounded-lg p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-semibold text-teal mb-4">
              Continuous Learning Approach
            </h3>
            <ul class="space-y-3 text-text-body text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Documentation-First:</strong> All processes documented and versioned
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Public Learning:</strong> Share insights through Lab and Learning Logs
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Experiment-Driven:</strong> Test new tools with measurable outcomes
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Peer Networks:</strong> Active in operations and tech communities
              </li>
            </ul>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-teal mb-4">
              Knowledge Management
            </h3>
            <ul class="space-y-3 text-text-body text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Personal Wiki:</strong> Centralized knowledge repository
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Template Library:</strong> Reusable processes and templates
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Case Study Archive:</strong> Documented wins and learnings
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal rounded-full"></span>
                <strong>Skills Matrix:</strong> Tracked competencies and gaps
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Stack Evolution -->
    <section class="mb-20" aria-labelledby="evolution-heading">
      <h2 id="evolution-heading" class="text-2xl font-bold text-text-heading mb-8">
        Stack Evolution Philosophy
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Principle 1: Business-First Technology
          </h3>
          <p class="text-text-body text-sm mb-4">
            Technology choices are driven by business problems, not technical preferences. 
            Every tool must solve a real operational challenge or enable growth.
          </p>
          <p class="text-text-body text-sm italic">
            "The best technology stack is invisible to the business - it just works."
          </p>
        </div>

        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Principle 2: Integration Over Complexity
          </h3>
          <p class="text-text-body text-sm mb-4">
            Prefer tools that integrate well over powerful but isolated systems. 
            Data flow and automation are more important than individual feature sets.
          </p>
          <p class="text-text-body text-sm italic">
            "Connected systems create compound value; isolated tools create compound problems."
          </p>
        </div>

        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold text-teal mb-4">
            Principle 3: Measurable Impact
          </h3>
          <p class="text-text-body text-sm mb-4">
            Every tool adoption must have clear success metrics and review cycles. 
            If a tool doesn't deliver measurable value, it gets replaced.
          </p>
          <p class="text-text-body text-sm italic">
            "What gets measured gets managed. What gets managed gets optimized."
          </p>
        </div>
      </div>
    </section>

    <!-- Navigation -->
    <nav class="mb-16" aria-label="Lab navigation">
      <div class="flex justify-between items-center bg-surface border border-border rounded-lg p-6">
        <a 
          href="/lab" 
          class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to Lab
        </a>
        
        <a 
          href="/connect" 
          class="inline-flex items-center gap-2 text-text-body hover:text-text-heading transition-colors"
        >
          Discuss Your Stack
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </nav>

    <!-- CTA -->
    <section class="text-center">
      <h2 class="text-2xl font-bold text-text-heading mb-4">
        Building Your Operations Stack?
      </h2>
      <p class="text-text-body mb-8 max-w-2xl mx-auto">
        I help businesses select and implement technology stacks that drive operational excellence 
        and scale with growth. Let's discuss your specific challenges and goals.
      </p>
      <div class="flex justify-center gap-4">
        <a 
          href="/connect" 
          class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-8 py-4 rounded-lg transition-colors min-h-[44px] min-w-[44px]"
        >
          Let's Connect
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <a 
          href="/lab" 
          class="inline-flex items-center gap-2 border border-border text-text-heading hover:bg-surface font-medium px-8 py-4 rounded-lg transition-colors min-h-[44px] min-w-[44px]"
        >
          View My Work
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
