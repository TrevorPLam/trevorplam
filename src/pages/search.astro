---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SidebarNavigation from '../components/SidebarNavigation.astro';
import LoadingSpinner from '../components/LoadingSpinner.astro';

// Get query parameter from URL
const query = Astro.url.searchParams.get('q') || '';
const filter = Astro.url.searchParams.get('type') || '';

// Get all content collections
const allCapabilities = await getCollection('capabilities');
const allLearningLogs = await getCollection('learningLogs');
const allProjects = await getCollection('projects');
const allResources = await getCollection('resources');
const allCaseStudies = await getCollection('caseStudies');

// Combine all content for filtering
const allContent = [
  ...allCapabilities.map(item => ({ ...item, type: 'capability', url: `/capabilities/${item.data.slug}` })),
  ...allLearningLogs.map(item => ({ ...item, type: 'learning-log', url: `/lab/learning-log/${item.id}` })),
  ...allProjects.map(item => ({ ...item, type: 'project', url: `/lab/projects/${item.data.slug}` })),
  ...allResources.map(item => ({ ...item, type: 'resource', url: `/resources/${item.data.type}/${item.data.slug}` })),
  ...allCaseStudies.map(item => ({ ...item, type: 'case-study', url: `/cases/${item.id}` }))
];

// Filter content by type if specified
const filteredContent = filter
  ? allContent.filter(item => item.type === filter)
  : allContent;

// Get content type counts for filters
const typeCounts = allContent.reduce((acc, item) => {
  acc[item.type] = (acc[item.type] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<BaseLayout
  title={query ? `Search: ${query} - Trevor Lam` : 'Search - Trevor Lam'}
  description="Search across capabilities, case studies, learning logs, projects, and resources"
>
  <div class="flex">
    <SidebarNavigation />
    <main class="flex-1 ml-64 p-6">
      <div class="max-w-4xl mx-auto">
        <Breadcrumbs />

        <header class="mb-8">
          <h1 class="text-3xl font-bold text-text-heading mb-4">
            {query ? `Search Results: "${query}"` : 'Search'}
          </h1>

          <!-- Search Input -->
          <div class="mb-6">
            <SearchBar
              placeholder="Search all content..."
              autofocus={true}
              className="max-w-2xl"
            />
          </div>

          <!-- Content Type Filters -->
          <nav class="flex flex-wrap gap-2" aria-label="Filter by content type">
            <a
              href="/search?q={encodeURIComponent(query)}"
              class={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                !filter
                  ? 'bg-accent text-accent-foreground'
                  : 'bg-surface border border-border text-text-body hover:bg-accent/20'
              }`}
            >
              All ({allContent.length})
            </a>

            {Object.entries(typeCounts).map(([type, count]) => (
              <a
                href={`/search?q=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`}
                class={`px-4 py-2 rounded-md text-sm font-medium transition-colors capitalize ${
                  filter === type
                    ? 'bg-accent text-accent-foreground'
                    : 'bg-surface border border-border text-text-body hover:bg-accent/20'
                }`}
              >
                {type.replace('-', ' ')} ({count})
              </a>
            ))}
          </nav>
        </header>

        <section>
          {query ? (
            <div id="search" class="pagefind-ui"></div>
          ) : (
            <div class="text-center py-12">
              <h2 class="text-xl font-semibold text-text-heading mb-4">
                Search across all content
              </h2>
              <p class="text-text-body mb-8 max-w-2xl mx-auto">
                Find capabilities, case studies, learning logs, projects, and resources.
                Use the search bar above or press ⌘K to quickly search from anywhere on the site.
              </p>

              <!-- Quick access links -->
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
                <a
                  href="/capabilities"
                  class="p-6 bg-surface border border-border rounded-lg hover:bg-accent/20 transition-colors"
                >
                  <h3 class="font-semibold text-text-heading mb-2">Capabilities</h3>
                  <p class="text-sm text-text-body">
                    Explore operations, people, financial, and customer capabilities
                  </p>
                </a>

                <a
                  href="/cases"
                  class="p-6 bg-surface border border-border rounded-lg hover:bg-accent/20 transition-colors"
                >
                  <h3 class="font-semibold text-text-heading mb-2">Case Studies</h3>
                  <p class="text-sm text-text-body">
                    Real-world examples of problem-solving and impact
                  </p>
                </a>

                <a
                  href="/lab"
                  class="p-6 bg-surface border border-border rounded-lg hover:bg-accent/20 transition-colors"
                >
                  <h3 class="font-semibold text-text-heading mb-2">Lab</h3>
                  <p class="text-sm text-text-body">
                    Learning logs, projects, and technical experiments
                  </p>
                </a>

                <a
                  href="/resources"
                  class="p-6 bg-surface border border-border rounded-lg hover:bg-accent/20 transition-colors"
                >
                  <h3 class="font-semibold text-text-heading mb-2">Resources</h3>
                  <p class="text-sm text-text-body">
                    Playbooks, templates, and skills matrix
                  </p>
                </a>
              </div>
            </div>
          )}
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  #search {
    min-height: 400px;
  }

  /* Pagefind search results styling */
  .pagefind-ui__search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-surface);
    color: var(--color-text-heading);
    font-size: 1rem;
  }

  .pagefind-ui__search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .pagefind-ui__result {
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
    transition: background-color 0.2s ease;
  }

  .pagefind-ui__result:hover {
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .pagefind-ui__result:last-child {
    border-bottom: none;
  }

  .pagefind-ui__result-title {
    color: var(--color-text-heading);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    text-decoration: none;
  }

  .pagefind-ui__result-title:hover {
    color: var(--color-accent);
  }

  .pagefind-ui__result-excerpt {
    color: var(--color-text-body);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .pagefind-ui__result-url {
    color: var(--color-text-body);
    opacity: 0.7;
    font-size: 0.875rem;
  }

  /* Loading state */
  .pagefind-ui__loading {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-body);
  }

  /* No results state */
  .pagefind-ui__no-results {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-body);
  }
</style>

<script is:inline>
  // Initialize Pagefind search
  document.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q');

    if (query) {
      const searchContainer = document.getElementById('search');

      try {
        // Show loading state while Pagefind loads
        showLoadingState(searchContainer);

        // Load Pagefind script dynamically
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind.js';
        script.onload = async () => {
          try {
            // @ts-ignore - Pagefind is loaded dynamically
            const { PagefindUI } = window;

            new PagefindUI({
              element: '#search',
              showSubResults: true,
              showImages: false,
              translate: {
                placeholder: 'Search...',
                clear_search: 'Clear',
                zero_results: 'No results found. Try different keywords or browse all content.',
                alt_search: 'No results. Showing results for',
                search_suggestion: 'Did you mean?',
              }
            });

            // Pre-fill the search query
            const searchInput = document.querySelector('.pagefind-ui__search-input');
            if (searchInput) {
              searchInput.value = query;
              // Trigger search
              searchInput.dispatchEvent(new Event('input'));
            }
          } catch (error) {
            console.error('PagefindUI initialization failed:', error);
            showSearchUnavailableMessage(searchContainer);
          }
        };
        script.onerror = () => {
          console.error('Failed to load Pagefind script');
          showSearchUnavailableMessage(searchContainer);
        };
        document.head.appendChild(script);
      } catch (error) {
        console.error('Pagefind not available (development mode or first build):', error);
        showSearchUnavailableMessage(searchContainer);
      }
    }
  });

  function showSearchUnavailableMessage(container) {
    if (container) {
      container.innerHTML = `
        <div class="text-center py-12">
          <p class="text-text-body mb-4">
            Search index is being generated. This happens after the first build.
            In development, search is not available. Build the site with <code>npm run build</code> to enable search.
          </p>
          <a href="/search" class="text-accent hover:underline">
            Clear search and browse all content
          </a>
        </div>
      `;
    }
  }

  function showLoadingState(container) {
    if (container) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center p-8">
          <svg class="animate-spin w-8 h-8 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="mt-4 text-sm text-text-body">Loading search...</p>
        </div>
      `;
    }
  }
</script>
