---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Connect - Trevor Lam" 
  description="Get in touch with Trevor Lam, Operations Integrator and Chief of Staff professional based in DFW."
>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl font-bold text-text-heading mb-6">
        Let's Connect
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-2xl mx-auto">
        I'm currently seeking opportunities where I can help organizations stabilize operations and drive strategic initiatives.
      </p>
      
      <!-- Professional Identity -->
      <div class="text-center mb-6">
        <p class="text-lg text-text-heading font-medium">
          Operations Integrator · Active Texas Notary · DFW / Remote
        </p>
      </div>
      
      <!-- Availability Statement -->
      <div class="text-center mb-12">
        <p class="text-base text-text-body max-w-xl mx-auto">
          Open to <strong>Operations</strong>, <strong>Chief of Staff</strong>, and <strong>HR/Payroll</strong> roles. 
          Response within 24 hours.
        </p>
      </div>
    </header>

    <!-- Target Roles -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-text-heading mb-6 text-center">
        Target Opportunities
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto">
        <div class="bg-surface border border-border rounded-lg p-4">
          <h3 class="text-text-heading font-semibold mb-2">Operations</h3>
          <p class="text-text-body text-sm">Process optimization and operational excellence</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <h3 class="text-text-heading font-semibold mb-2">Chief of Staff</h3>
          <p class="text-text-body text-sm">Strategic support and executive partnership</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <h3 class="text-text-heading font-semibold mb-2">HR/Payroll</h3>
          <p class="text-text-body text-sm">Compliance and payroll operations expertise</p>
        </div>
        <div class="bg-surface border border-border rounded-lg p-4">
          <h3 class="text-text-heading font-semibold mb-2">Firm Administration</h3>
          <p class="text-text-body text-sm">Legal and professional services operations</p>
        </div>
      </div>
    </section>

    <!-- Primary CTA -->
    <section class="text-center mb-16">
      <div class="max-w-md mx-auto">
        <h2 class="text-2xl font-bold text-text-heading mb-6">
          Ready to Discuss Opportunities?
        </h2>
        
        <!-- LinkedIn CTA Button -->
        <div class="mb-6">
          <a 
            href="https://linkedin.com/in/trevor-lam" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full bg-accent hover:bg-accent/90 text-white font-semibold py-4 px-6 rounded-lg min-h-[48px] transition-colors"
            aria-label="Connect with Trevor Lam on LinkedIn"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            Connect on LinkedIn
          </a>
        </div>

        <!-- Email Link -->
        <div class="text-center">
          <p class="text-text-body mb-2">Or send a direct message:</p>
          <a 
            href="mailto:trevor@trevor-lam.com" 
            class="text-accent hover:text-accent/80 font-medium transition-colors"
            aria-label="Send email to trevor@trevor-lam.com"
          >
            trevor@trevor-lam.com
          </a>
        </div>
      </div>
    </section>

    <!-- Response Expectation -->
    <section class="text-center">
      <div class="bg-surface border border-border rounded-lg p-6 max-w-md mx-auto">
        <h3 class="text-text-heading font-semibold mb-2">What to Expect</h3>
        <p class="text-text-body text-sm">
          I typically respond within 24-48 hours. I'm excited to learn about your organization and discuss how I can contribute to your success.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
