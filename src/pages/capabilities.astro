---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = await getCollection('capabilities');
---

<BaseLayout 
  title="Capabilities - Trevor Lam" 
  description="Core competencies and technical proficiencies I bring to operations, financial controls, and people leadership roles."
  jsonLd={{
    '@type': 'ItemList',
    name: 'Core Capabilities',
    description: 'Comprehensive overview of professional capabilities and expertise areas.',
    numberOfItems: capabilities.length,
    itemListElement: capabilities.map((capability, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: capability.data.title,
      description: capability.data.philosophy,
      url: `${new URL(Astro.url.origin)}/capabilities/${capability.data.slug}`
    }))
  }}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Capabilities
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Core competencies and technical proficiencies I bring to operations, financial controls, and people leadership roles.
      </p>
    </header>

    <!-- Capabilities Grid -->
    <section class="mb-20" aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading" class="sr-only">Core Capabilities</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {capabilities.map((capability) => (
          <article class="bg-surface border border-border rounded-lg p-6 hover:shadow-lg transition-shadow duration-300">
            <header class="mb-4">
              <h3 class="text-xl font-bold text-text-heading mb-2">
                <a 
                  href={`/capabilities/${capability.data.slug}`}
                  class="hover:text-accent transition-colors duration-200"
                >
                  {capability.data.title}
                </a>
              </h3>
              <p class="text-sm text-text-body/70 line-clamp-3">
                {capability.data.philosophy}
              </p>
            </header>

            <!-- KPIs Preview -->
            <div class="mb-4">
              <h4 class="text-sm font-semibold text-text-heading mb-2">Key Metrics</h4>
              <div class="grid grid-cols-2 gap-2">
                {capability.data.kpis.slice(0, 4).map((kpi) => (
                  <div class="text-xs p-2 bg-surface/50 rounded border border-border">
                    <div class="font-medium text-text-body/80">{kpi.name}</div>
                    <div class="font-bold text-text-heading">{kpi.value}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Industries -->
            {capability.data.industries.length > 0 && (
              <div class="mb-4">
                <h4 class="text-sm font-semibold text-text-heading mb-2">Industries</h4>
                <div class="flex flex-wrap gap-1">
                  {capability.data.industries.map((industry) => (
                    <span class="text-xs px-2 py-1 bg-accent/10 text-accent-text rounded border border-accent/20">
                      {industry}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Call to Action -->
            <div class="flex items-center justify-between">
              <a 
                href={`/capabilities/${capability.data.slug}`}
                class="inline-flex items-center gap-2 text-accent hover:text-accent/80 font-medium text-sm transition-colors duration-200"
              >
                Explore Capability
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
              
              <time class="text-xs text-text-body/50" datetime={capability.data.lastUpdated.toISOString()}>
                Updated: {capability.data.lastUpdated.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'short', 
                  day: 'numeric' 
                })}
              </time>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center mt-16">
      <a 
        href="/connect" 
        class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-8 py-4 rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
      >
        Let's Connect
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>
