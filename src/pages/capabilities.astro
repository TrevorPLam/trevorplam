---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Capabilities - Trevor Lam" 
  description="Core competencies and technical proficiencies I bring to operations, financial controls, and people leadership roles."
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <header class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-text-heading mb-6">
        Capabilities
      </h1>
      <p class="text-xl text-text-body mb-8 max-w-3xl mx-auto">
        Core competencies and technical proficiencies I bring to operations, financial controls, and people leadership roles.
      </p>
    </header>

    <!-- Four Column Skills Grid -->
    <section class="mb-20" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="sr-only">Skills Inventory</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Column 1: Operational Excellence -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-xl font-bold text-text-heading mb-6 pb-4 border-b border-border">
            Operational Excellence & Process Optimization
          </h3>
          <ul class="space-y-3 text-text-body">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Multi-Entity Operations Management</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Workflow Architecture & Paper-to-Digital Migration</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>KPI Management & P&L Ownership</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>SOP Development & Compliance Documentation</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Vendor Management (20+ providers)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Information Systems Design</span>
            </li>
          </ul>
        </div>

        <!-- Column 2: Financial Controls -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-xl font-bold text-text-heading mb-6 pb-4 border-b border-border">
            Financial Controls & Payroll Management
          </h3>
          <ul class="space-y-3 text-text-body">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Payroll Processing (APEX, 315+ client accounts)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>QuickBooks Online (QBO) & Xero Bookkeeping</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Month-End Close & Financial Reporting</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Zero-Discrepancy Reconciliation & Audit Readiness</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Accounts Payable/Receivable & Collections</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Multi-Entity Accounting</span>
            </li>
          </ul>
        </div>

        <!-- Column 3: People Operations -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-xl font-bold text-text-heading mb-6 pb-4 border-b border-border">
            People Operations & Cross-Functional Leadership
          </h3>
          <ul class="space-y-3 text-text-body">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Full-Cycle Recruiting & Onboarding</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Benefits Administration (Medical/Dental/Vision/Retirement)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>ERISA & ACA Compliance Familiarity</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Employee Retention Strategy</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Leadership Training & Development (AMLC Instructor)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Performance Management</span>
            </li>
          </ul>
        </div>

        <!-- Column 4: Executive Support -->
        <div class="bg-surface border border-border rounded-lg p-6">
          <h3 class="text-xl font-bold text-text-heading mb-6 pb-4 border-b border-border">
            Executive Support & Business Administration
          </h3>
          <ul class="space-y-3 text-text-body">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Calendar & Inbox Management for Principals</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Client Onboarding & Relationship Management</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Independent AR Collections</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Marketing Operations (HubSpot, ActiveCampaign, Google Ads)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>AI Productivity Tools (ChatGPT, Claude, Perplexity, Gemini)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span>Typing Speed: 80 WPM</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Technical Proficiencies Footer -->
    <section class="bg-surface/50 border border-border rounded-lg p-8" aria-labelledby="technical-heading">
      <h2 id="technical-heading" class="text-2xl font-bold text-text-heading mb-6 text-center">
        Technical Proficiencies
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Accounting & Payroll -->
        <div>
          <h4 class="font-semibold text-text-heading mb-3 text-accent">Accounting & Payroll</h4>
          <p class="text-text-body text-sm">
            QuickBooks Online, Xero, APEX Payroll, Thomson Reuters, SafeSend, Karbon
          </p>
        </div>

        <!-- Office & Productivity -->
        <div>
          <h4 class="font-semibold text-text-heading mb-3 text-accent">Office & Productivity</h4>
          <p class="text-text-body text-sm">
            Microsoft Excel (Pivot Tables, VLOOKUPs), Outlook, Word, PowerPoint, Google Workspace, Teams, Zoom
          </p>
        </div>

        <!-- Marketing & CRM -->
        <div>
          <h4 class="font-semibold text-text-heading mb-3 text-accent">Marketing & CRM</h4>
          <p class="text-text-body text-sm">
            HubSpot, ActiveCampaign, Google Ads, Google Business Profile, Google Search Console
          </p>
        </div>

        <!-- Credentials -->
        <div>
          <h4 class="font-semibold text-text-heading mb-3 text-accent">Credentials</h4>
          <p class="text-text-body text-sm">
            Active Texas Notary Public
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center mt-16">
      <a 
        href="/connect" 
        class="inline-flex items-center gap-2 bg-teal hover:bg-teal/90 text-white font-medium px-8 py-4 rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
      >
        Let's Connect
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>
