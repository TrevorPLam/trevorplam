<section class="py-20 px-6" aria-labelledby="industry-fluidity-heading">
	<div class="max-w-6xl mx-auto">
		<header class="text-center mb-16">
			<h2 id="industry-fluidity-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				Industry Fluidity
			</h2>
			<p class="text-xl text-text-body max-w-3xl mx-auto">
				Adapting operational excellence across diverse economic engines.
			</p>
		</header>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
			<!-- Sonic Drive-in -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">Sonic Drive-in</h3>
				</div>
				<p class="text-sm text-accent font-medium mb-3">QSR Franchise Operations</p>
				<p class="text-text-body leading-relaxed">
					Transformed payroll chaos into precision for 500+ employees across three states. 
					Implemented automated time tracking and standardized wage calculations, achieving 
					99.8% payroll accuracy and 100% compliance audit pass rate. Demonstrated ability to 
					scale operational systems across multi-unit franchise environments.
				</p>
			</article>

			<!-- Grandlux Hospitality -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">Grandlux Hospitality</h3>
				</div>
				<p class="text-sm text-accent font-medium mb-3">Multi-Location Restaurant Group</p>
				<p class="text-text-body leading-relaxed">
					Revolutionized financial operations from 12-day to 4-day monthly close cycle. 
					Elevated inventory accuracy from 76% to 94.2% through systematic process redesign 
					and real-time cost tracking implementation. Proven expertise in financial 
					controls and operational efficiency for complex restaurant portfolios.
				</p>
			</article>

			<!-- KLW CPAs -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">KLW CPAs</h3>
				</div>
				<p class="text-sm text-accent font-medium mb-3">CPA & Payroll Services Firm</p>
				<p class="text-text-body leading-relaxed">
					Streamlined HR operations reducing employee onboarding from 14 days to 3 days. 
					Improved benefits enrollment accuracy from 81% to 98.5% through automated client 
					data synchronization and standardized HR workflows. Demonstrated capacity to 
					optimize professional service operations and ensure regulatory compliance.
				</p>
			</article>
		</div>
	</div>
</section>
