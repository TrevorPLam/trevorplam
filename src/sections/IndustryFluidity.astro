---
---

<section class="py-20 px-6" aria-labelledby="industry-fluidity-heading">
	<div class="max-w-6xl mx-auto">
		<header class="text-center mb-16">
			<h2 id="industry-fluidity-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				Industry Fluidity
			</h2>
			<p class="text-xl text-text-body max-w-3xl mx-auto">
				Adapting operational excellence across diverse economic engines.
			</p>
		</header>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
			<!-- Sonic Drive-in -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">Sonic Drive-in</h3>
				</div>
				<p class="text-sm text-accent-text font-medium mb-3">QSR Franchise Operations</p>
				<p class="text-text-body leading-relaxed">
					Unit optimization with $1.4M initial revenue, grew to $1.7M (~21% growth)
					and achieved top 10% KPI rank within 18 months. Reduced food cost variance from 2.7% to 0.75%
					and employee turnover from 175%+ to under 80%. Earned three consecutive annual awards.
				</p>
			</article>

			<!-- Grandlux Hospitality -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">Grandlux Hospitality</h3>
				</div>
				<p class="text-sm text-accent-text font-medium mb-3">Multi-Location Restaurant Group</p>
				<p class="text-text-body leading-relaxed">
					Managed 17-technician commission floor with zero cash discrepancies across all
					end-of-day reconciliations. Reduced Google review complaints through proactive
					service recovery before client departure. Maintained Texas cosmetology compliance
					while handling unpredictable walk-in volume via real-time capacity optimization.
				</p>
			</article>

			<!-- KLW CPAs -->
			<article class="space-y-4">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-2 h-2 bg-teal rounded-full"></div>
					<h3 class="text-xl font-semibold text-text-heading">KLW CPAs</h3>
				</div>
				<p class="text-sm text-accent-text font-medium mb-3">CPA & Payroll Services Firm</p>
				<p class="text-text-body leading-relaxed">
					Promoted twice in 18 months (60 days to Executive Assistant, then to Integrator).
					Managed 280-315+ payroll client accounts across 3 legally distinct entities with
					zero breaches. Led complete paper-to-digital transition and achieved audit readiness
					across multi-entity environment with 200+ tax workflows.
				</p>
			</article>
		</div>
	</div>
</section>
