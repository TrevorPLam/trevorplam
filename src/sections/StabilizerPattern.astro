---
import OptimizedImage from '../components/OptimizedImage.astro';
---

<section class="py-20 px-6" aria-labelledby="stabilizer-pattern-heading">
	<div class="max-w-6xl mx-auto">
		<header class="text-center mb-16">
			<h2 id="stabilizer-pattern-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				The Stabilizer Pattern
			</h2>
			<p class="text-xl text-text-body max-w-3xl mx-auto">
				The pattern has been validated across three distinct economic engines.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Sonic Drive-in Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">Sonic Drive-in</h3>
					<p class="text-sm text-accent font-medium">QSR Franchise Operations</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-red-400 mb-2">Chaos Inherited</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 87% payroll accuracy rate</li>
							<li>• 72% compliance audit pass rate</li>
							<li>• Manual time tracking errors</li>
							<li>• Inconsistent wage calculations</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal mb-2">Result Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 99.8% payroll accuracy rate</li>
							<li>• 100% compliance audit pass rate</li>
							<li>• Automated time tracking system</li>
							<li>• Standardized wage calculations</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- Grandlux Hospitality Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">Grandlux Hospitality</h3>
					<p class="text-sm text-accent font-medium">Multi-Location Restaurant Group</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-red-400 mb-2">Chaos Inherited</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 12-day monthly financial close</li>
							<li>• 76% inventory accuracy rate</li>
							<li>• Manual P&L reporting delays</li>
							<li>• Inconsistent cost tracking</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal mb-2">Result Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 4-day monthly financial close</li>
							<li>• 94.2% inventory accuracy rate</li>
							<li>• Automated P&L reporting</li>
							<li>• Real-time cost tracking</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- KLW CPAs Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">KLW CPAs</h3>
					<p class="text-sm text-accent font-medium">CPA & Payroll Services Firm</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-red-400 mb-2">Chaos Inherited</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 14-day employee onboarding</li>
							<li>• 81% benefits enrollment accuracy</li>
							<li>• Manual client data entry</li>
							<li>• Inconsistent HR processes</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal mb-2">Result Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 3-day employee onboarding</li>
							<li>• 98.5% benefits enrollment accuracy</li>
							<li>• Automated client data sync</li>
							<li>• Standardized HR workflows</li>
						</ul>
					</div>
				</div>
			</article>
		</div>
	</div>
</section>
