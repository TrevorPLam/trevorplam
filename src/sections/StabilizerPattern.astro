---
import OptimizedImage from '../components/OptimizedImage.astro';
---

<section class="py-20 px-6" aria-labelledby="stabilizer-pattern-heading">
	<div class="max-w-6xl mx-auto">
		<header class="text-center mb-16">
			<h2 id="stabilizer-pattern-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				The Pattern Across Three Industries
			</h2>
			<p class="text-xl text-text-body max-w-3xl mx-auto">
				Same approach, same results—across fast food, salons, and professional services.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Sonic Drive-in Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">Sonic Drive-in</h3>
					<p class="text-sm text-accent-text font-medium">QSR Franchise — 12 Year Progression</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-accent-text mb-2">Initial State (2016)</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• $1.4M revenue, untapped potential</li>
							<li>• Food cost variance 2.7%</li>
							<li>• Employee turnover at 175%+</li>
							<li>• Bottom-tier KPI performance</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal-text mb-2">What I Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• $1.7M revenue (~21% growth)</li>
							<li>• Top 10% KPI rank</li>
							<li>• Food cost variance 0.75%</li>
							<li>• Turnover under 80%</li>
							<li>• 3 consecutive annual awards</li>
							<li>• Youngest AMLC Instructor in org history</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- Grandlux Nail Salon Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">Grandlux Nail Salon</h3>
					<p class="text-sm text-accent-text font-medium">Commission Floor Operations</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-accent-text mb-2">Operational Context</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• 17 commission-based technicians</li>
							<li>• High-volume cash environment</li>
							<li>• Unpredictable walk-in demand</li>
							<li>• Reputation management needs</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal-text mb-2">What I Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• Zero cash discrepancies</li>
							<li>• Proactive service recovery</li>
							<li>• Real-time capacity optimization</li>
							<li>• Texas cosmetology compliance maintained</li>
							<li>• Role held concurrent with degree (by design)</li>
						</ul>
					</div>
				</div>
			</article>

			<!-- KLW Financial Group Card -->
			<article class="bg-surface border border-border rounded-lg p-8 hover:shadow-lg transition-shadow">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-text-heading mb-2">K.L.W. Financial Group</h3>
					<p class="text-sm text-accent-text font-medium">3 Legally Distinct Entities</p>
				</div>
				
				<div class="space-y-6">
					<div>
						<h4 class="text-sm font-semibold text-accent-text mb-2">Operational Context</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• Three legally distinct entities sharing systems</li>
							<li>• Hybrid paper-and-digital workflows</li>
							<li>• 315+ payroll clients requiring coordination</li>
							<li>• Month-end close optimization opportunity</li>
						</ul>
					</div>
					
					<div>
						<h4 class="text-sm font-semibold text-teal-text mb-2">What I Delivered</h4>
						<ul class="text-sm text-text-body space-y-1">
							<li>• Promoted twice in 18 months</li>
							<li>• 60-day first promotion (fastest ever)</li>
							<li>• Integrator (#2 operational role)</li>
							<li>• Full paper-to-digital transition</li>
							<li>• Zero breaches across 3 entities</li>
						</ul>
					</div>
				</div>
			</article>
		</div>
	</div>
</section>
