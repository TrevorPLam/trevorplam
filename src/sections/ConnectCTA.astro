---

<section class="py-20 px-6 bg-surface/50" aria-labelledby="connect-heading">
	<div class="max-w-4xl mx-auto text-center">
		<header class="mb-12">
			<h2 id="connect-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				Ready to Optimize Your Operations
			</h2>
			<p class="text-xl text-text-body max-w-2xl mx-auto">
				Let's discuss how systematic operational stabilization can drive measurable results for your organization.
			</p>
		</header>

		<div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
			<!-- LinkedIn Button -->
			<a 
				href="https://linkedin.com/in/trevor-lam" 
				target="_blank" 
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-teal hover:bg-teal/90 text-white font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px] focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2 focus:ring-offset-surface"
				aria-label="Connect with Trevor Lam on LinkedIn (opens in new tab)"
			>
				<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
				</svg>
				Connect on LinkedIn
			</a>

			<!-- Message Button -->
			<a 
				href="mailto:trevor.lam.operations@gmail.com" 
				class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-surface hover:bg-surface/80 border border-border text-text-heading font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px] focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface"
				aria-label="Send email to Trevor Lam"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
				</svg>
				Send a Message
			</a>
		</div>

		<!-- Availability Note -->
		<div class="mt-12 p-6 bg-bg border border-border rounded-lg">
			<p class="text-text-body text-sm leading-relaxed">
				<span class="font-semibold text-text-heading">Current Availability:</span> Open to Chief of Staff, 
				Operations Manager, and senior operational leadership opportunities. 
				Specializing in operational optimization, compliance excellence, and scaling challenges.
			</p>
		</div>
	</div>
</section>
