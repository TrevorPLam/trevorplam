---
import OptimizedImage from '../components/OptimizedImage.astro';
import headshot from '../assets/headshot.svg';
---

<section class="min-h-screen flex items-center justify-center px-6 py-20" role="main">
	<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
		<!-- Text Content -->
		<header class="space-y-6">
			<h1 class="text-5xl lg:text-6xl font-bold text-text-heading leading-tight">
				Trevor Lam
			</h1>
			<p class="text-2xl lg:text-3xl text-text-body font-medium">
				Operations Integrator · Forensic Stabilizer
			</p>
			<p class="text-lg text-text-body leading-relaxed max-w-lg">
				I'm the person you call when the machine is breaking, the money is leaking, and the people are quitting.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 pt-4">
				<a 
					href="/evidence" 
					class="inline-flex items-center justify-center px-6 py-3 bg-teal hover:bg-teal/90 text-white font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
				>
					View the Evidence
				</a>
				<a 
					href="#" 
					class="inline-flex items-center justify-center px-6 py-3 bg-surface hover:bg-surface/80 border border-border text-text-heading font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
				>
					Download Resume
				</a>
			</div>
		</header>

		<!-- Headshot -->
		<div class="flex justify-center lg:justify-end">
			<div class="relative">
				<OptimizedImage 
					src={headshot}
					alt="Trevor Lam - Operations Integrator and Forensic Stabilizer"
					width={400}
					height={400}
					priority={true}
					class="rounded-2xl shadow-2xl border border-border"
				/>
			</div>
		</div>
	</div>
</section>
