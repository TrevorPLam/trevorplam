---
import OptimizedImage from '../components/OptimizedImage.astro';
import headshot from '../assets/headshot.svg';
---

<section class="min-h-screen flex items-center justify-center px-6 py-20">
	<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
		<!-- Text Content -->
		<header class="space-y-6">
			<div class="flex items-center gap-3">
				<h1 class="text-5xl lg:text-6xl font-bold text-text-heading leading-tight">
					Trevor Lam
				</h1>
				<span class="inline-flex items-center px-3 py-1 bg-teal/10 text-teal-text text-sm font-semibold rounded-full border border-teal/20">
					17 Years
				</span>
			</div>
			<p class="text-2xl lg:text-3xl text-text-body font-medium">
				Operations Leader · Scalable Systems & Financial Controls · Active Texas Notary
			</p>
			<p class="text-lg text-text-body leading-relaxed max-w-lg">
				I Scale and Optimize Operations for High-Growth Teams.
			</p>
			<p class="text-base text-text-heading font-medium max-w-lg">
				I drove a 21% revenue increase and reduced turnover by over half at a high-volume Sonic Drive-in, moving it into the top 10% of company performers.
			</p>
			<p class="text-sm text-text-muted italic max-w-lg">
				I build the systems that let teams focus on growth instead of operations.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 pt-4">
				<a 
					href="/impact" 
					class="inline-flex items-center justify-center px-6 py-3 bg-teal hover:bg-teal/90 text-white font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
				>
					View My Impact
				</a>
				<a 
					href="https://linkedin.com/in/trevor-lam" 
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center px-6 py-3 bg-surface hover:bg-surface/80 border border-border text-text-heading font-medium rounded-lg transition-colors duration-200 min-h-[44px] min-w-[44px]"
				>
					Connect on LinkedIn
				</a>
			</div>
		</header>

		<!-- Headshot -->
		<div class="flex justify-center lg:justify-end">
			<div class="relative">
				<OptimizedImage 
					src={headshot}
					alt="Trevor Lam - Operations Integrator and Forensic Stabilizer"
					width={400}
					height={400}
					priority={true}
					class="rounded-2xl shadow-2xl border border-border"
				/>
			</div>
		</div>
	</div>
</section>
