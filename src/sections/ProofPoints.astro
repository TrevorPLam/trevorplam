---
import MetricCard from '../components/MetricCard.astro';
import metrics from '../../data/metrics.json';
---

<section class="py-20 px-6 bg-surface/50" aria-labelledby="proof-points-heading">
	<div class="max-w-6xl mx-auto">
		<header class="text-center mb-16">
			<h2 id="proof-points-heading" class="text-3xl lg:text-4xl font-bold text-text-heading mb-6">
				Quantified Impact
			</h2>
			<p class="text-xl text-text-body max-w-3xl mx-auto">
				Measurable improvements across payroll, compliance, operations, and financial controls.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{metrics.map((metric) => (
				<MetricCard
					title={metric.title}
					before={metric.before}
					after={metric.after}
					context={metric.context}
					skillTag={metric.skillTag}
					caseStudySlug={metric.caseStudySlug}
				/>
			))}
		</div>

		<!-- Zero-Discrepancy Pattern Banner -->
		<div class="mt-16 bg-bg border-2 border-teal/30 rounded-xl p-8">
			<div class="text-center mb-6">
				<h3 class="text-2xl font-bold text-text-heading mb-2">Perfect Financial Records—Three Different Industries</h3>
				<p class="text-text-body max-w-2xl mx-auto">
					I balanced the books perfectly across Sonic (fast food), Grandlux (salon), and KLW (payroll/CPA)—
					despite having zero prior experience in two of them. The industry changes; the precision doesn't.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class="bg-surface rounded-lg p-4 text-center">
					<div class="text-teal-text font-bold text-lg mb-1">Sonic Drive-in</div>
					<div class="text-text-body text-sm">Daily deposits & petty cash</div>
					<div class="text-text-heading font-semibold mt-2">Zero discrepancies</div>
				</div>
				<div class="bg-surface rounded-lg p-4 text-center">
					<div class="text-teal-text font-bold text-lg mb-1">Grandlux Salon</div>
					<div class="text-text-body text-sm">End-of-day cash reconciliation</div>
					<div class="text-text-heading font-semibold mt-2">Zero discrepancies</div>
				</div>
				<div class="bg-surface rounded-lg p-4 text-center">
					<div class="text-teal-text font-bold text-lg mb-1">KLW Financial</div>
					<div class="text-text-body text-sm">Month-end close & 315+ payroll accounts</div>
					<div class="text-text-heading font-semibold mt-2">Zero discrepancies</div>
				</div>
			</div>
		</div>
	</div>
</section>
