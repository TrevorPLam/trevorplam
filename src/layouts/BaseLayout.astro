---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SidebarNavigation from '../components/SidebarNavigation.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SearchBar from '../components/SearchBar.astro';
import Footer from '../components/Footer.astro';
import ErrorBoundary from '../components/ErrorBoundary.astro';

export interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	excludeAnalytics?: boolean;
}

const { title, description, ogImage = '/images/og-image.svg', ogType = 'website', jsonLd, excludeAnalytics = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.toString() || 'https://trevor-lam.com';

// Base JSON-LD structured data with Person and WebSite schemas
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Trevor Lam',
      url: siteUrl,
      sameAs: ['https://linkedin.com/in/trevor-lam'],
      jobTitle: 'Operations & Financial Controls Leader',
      description: 'Operations leader specializing in scalable systems, financial controls, and people operations for multi-unit and professional services businesses.',
      knowsAbout: [
        'Operations Management',
        'Chief of Staff',
        'HR/Payroll Systems',
        'Business Process Optimization',
        'Information Architecture',
        'Financial Controls'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Chief of Staff Hub — Trevor Lam',
      author: { '@id': `${siteUrl}#person` },
      mainEntityOfPage: canonicalUrl.toString()
    }
  ]
};

// Merge additional JSON-LD if provided
const finalJsonLd = jsonLd
  ? (Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': [...baseJsonLd['@graph'], ...jsonLd] } : jsonLd)
  : baseJsonLd;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- PWA Manifest -->
		<link rel="manifest" href="/manifest.webmanifest" />

		<!-- RSS Feed Auto-Discovery -->
		<link rel="alternate" type="application/rss+xml" title="Trevor Lam - Learning Log" href="/rss.xml" />

		<!-- Speculation Rules API for Instant Navigation -->
		<script type="speculationrules">
			{
				"prerender": [
					{
						"where": {
							"and": [
								{ "href_matches": "/*" },
								{ "not": { "href_matches": "/*.{pdf,zip,doc,docx}" } },
								{ "not": { "selector_matches": "[download]" } }
							]
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="author" content="Trevor Lam" />
		<meta name="keywords" content="operations management, chief of staff, financial controls, business process optimization, HR payroll systems, supply chain management" />
		<meta name="robots" content="index, follow" />
		<meta name="language" content="English" />
		<meta name="theme-color" content="#000000" />

		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL(ogImage, siteUrl)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Chief of Staff Hub - Trevor Lam" />
		<meta property="og:site_name" content="Chief of Staff Hub - Trevor Lam" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteUrl)} />
		<meta name="twitter:image:alt" content="Chief of Staff Hub - Trevor Lam" />
		<meta name="twitter:creator" content="@trevorlam" />
		<meta name="twitter:site" content="@trevorlam" />

		<!-- Additional SEO Meta Tags -->
		<meta name="application-name" content="Chief of Staff Hub" />
		<meta name="apple-mobile-web-app-title" content="Chief of Staff Hub" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="msapplication-TileColor" content="#000000" />
		<meta name="msapplication-config" content="/browserconfig.xml" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

		<!-- Theme Initialization - Must run before page renders to prevent FOUC -->
		<script is:inline>
			(function() {
				try {
					const savedTheme = localStorage.getItem('theme');
					if (savedTheme === 'light' || savedTheme === 'dark') {
						document.documentElement.classList.toggle('dark', savedTheme === 'dark');
					} else {
						// Respect system preference
						const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
						document.documentElement.classList.toggle('dark', prefersDark);
					}
				} catch {
					// Storage unavailable - use system preference
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', prefersDark);
				}
			})();
		</script>

		<!-- Analytics Opt-Out Check - Must run before analytics load -->
		<script is:inline>
			(function() {
				try {
					const isOptedOut = localStorage.getItem('plausible_optout') === 'true';
					if (isOptedOut) {
						window.plausibleOptOut = true;
					}
				} catch (e) {
					// Storage unavailable - default to analytics enabled
					console.warn('Failed to check analytics opt-out:', e);
				}
			})();
		</script>
	</head>
	<body class="bg-background text-text-body antialiased min-h-screen flex flex-col">
		<!-- Service Worker Registration -->
		<script is:inline>
			(function() {
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', () => {
						navigator.serviceWorker.register('/sw.js').then((registration) => {
							console.log('Service Worker registered:', registration);
						}).catch((error) => {
							console.warn('Service Worker registration failed:', error);
						});
					});
				}
			})();
		</script>

		<!-- Resource Hints for Third-Party Domains -->
		{!excludeAnalytics && (
			<>
				<link rel="dns-prefetch" href="https://plausible.io" />
				<link rel="preconnect" href="https://plausible.io" crossorigin />
			</>
		)}

		<!-- Analytics: Plausible (Privacy-First) - Conditionally loaded based on opt-out -->
		{!excludeAnalytics && (
			<script defer>
				(function() {
					try {
						const isOptedOut = localStorage.getItem('plausible_optout') === 'true';
						if (!isOptedOut) {
							const script = document.createElement('script');
							script.defer = true;
							script.dataset.domain = 'trevor-lam.com';
							script.src = 'https://plausible.io/js/script.js';
							document.head.appendChild(script);
						}
					} catch (e) {
						// Storage unavailable - load analytics by default
						const script = document.createElement('script');
						script.defer = true;
						script.dataset.domain = 'trevor-lam.com';
						script.src = 'https://plausible.io/js/script.js';
						document.head.appendChild(script);
					}
				})();
			</script>
		)}

		<!-- Error Monitoring - Deferred to not block rendering -->
		{!excludeAnalytics && (
			<script defer>
				import '../utils/error-monitoring';
			</script>
		)}

		<!-- Real User Monitoring - Deferred to not block rendering -->
		{!excludeAnalytics && (
			<script defer>
				import '../utils/rum-monitoring';
			</script>
		)}

		<ClientRouter />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
	</head>
	<body class="bg-bg text-text-body">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-surface text-text-heading px-4 py-2 rounded border border-border z-50">
			Skip to Content
		</a>
		
		<!-- Mobile Menu Button -->
		<div class="md:hidden fixed top-4 left-4 z-50">
			<button
				type="button"
				class="bg-surface border border-border rounded-md p-2 text-text-body hover:text-text-heading min-h-[44px] min-w-[44px] flex items-center justify-center"
				aria-label="Open navigation menu"
				aria-expanded="false"
				id="mobile-menu-button"
				@click="window.openSidebar()"
			>
				<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>

		<!-- Search Bar (Top Right) -->
		<section class="fixed top-4 right-4 z-40 w-64 max-w-[calc(100vw-8rem)]" aria-label="Site search">
			<SearchBar />
		</section>

		<SidebarNavigation />
		
		<ErrorBoundary>
		<main id="main-content" class="ml-0 md:ml-64 pt-16 md:pt-0" aria-label="Main content area">
			<div class="max-w-6xl mx-auto p-6">
				<Breadcrumbs />
				<div class="mt-4">
					<slot />
				</div>
			</div>
		</main>
	</ErrorBoundary>
		<footer aria-label="Site footer">
			<Footer />
		</footer>
	</body>
</html>
