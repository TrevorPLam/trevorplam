---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SidebarNavigation from '../components/SidebarNavigation.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SearchBar from '../components/SearchBar.astro';
import Footer from '../components/Footer.astro';
import ErrorBoundary from '../components/ErrorBoundary.astro';

export interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = '/images/og-image.svg', ogType = 'website', jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.toString() || 'https://trevor-lam.com';

// Base JSON-LD structured data with Person and WebSite schemas
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Trevor Lam',
      url: siteUrl,
      sameAs: ['https://linkedin.com/in/trevor-lam'],
      jobTitle: 'Operations & Financial Controls Leader',
      description: 'Operations leader specializing in scalable systems, financial controls, and people operations for multi-unit and professional services businesses.',
      knowsAbout: [
        'Operations Management',
        'Chief of Staff',
        'HR/Payroll Systems',
        'Business Process Optimization',
        'Information Architecture',
        'Financial Controls'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Chief of Staff Hub — Trevor Lam',
      author: { '@id': `${siteUrl}#person` },
      mainEntityOfPage: canonicalUrl.toString()
    }
  ]
};

// Merge additional JSON-LD if provided
const finalJsonLd = jsonLd
  ? (Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': [...baseJsonLd['@graph'], ...jsonLd] } : jsonLd)
  : baseJsonLd;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL(ogImage, siteUrl)} />
		<meta property="og:site_name" content="Chief of Staff Hub — Trevor Lam" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

		<!-- Resource Hints for Third-Party Domains -->
		<link rel="dns-prefetch" href="https://plausible.io" />
		<link rel="preconnect" href="https://plausible.io" crossorigin />

		<!-- Analytics: Plausible (Privacy-First) - Deferred for performance -->
		<script defer data-domain="trevor-lam.com" src="https://plausible.io/js/script.js"></script>

		<!-- Error Monitoring - Deferred to not block rendering -->
		<script defer>
			import '../utils/error-monitoring';
		</script>

		<!-- Real User Monitoring - Deferred to not block rendering -->
		<script defer>
			import '../utils/rum-monitoring';
		</script>

		<ClientRouter />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
	</head>
	<body class="bg-bg text-text-body">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-surface text-text-heading px-4 py-2 rounded border border-border z-50">
			Skip to Content
		</a>
		
		<!-- Mobile Menu Button -->
		<div class="md:hidden fixed top-4 left-4 z-50">
			<button
				type="button"
				class="bg-surface border border-border rounded-md p-2 text-text-body hover:text-text-heading min-h-[44px] min-w-[44px] flex items-center justify-center"
				aria-label="Open navigation menu"
				aria-expanded="false"
				id="mobile-menu-button"
				@click="window.openSidebar()"
			>
				<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>

		<!-- Search Bar (Top Right) -->
		<div class="fixed top-4 right-4 z-40 w-64 max-w-[calc(100vw-8rem)]">
			<SearchBar />
		</div>

		<SidebarNavigation />
		
		<ErrorBoundary>
		<main id="main-content" class="ml-0 md:ml-64 pt-16 md:pt-0">
			<div class="max-w-6xl mx-auto p-6">
				<Breadcrumbs />
				<div class="mt-4">
					<slot />
				</div>
			</div>
		</main>
	</ErrorBoundary>
		<footer aria-label="Site footer">
			<Footer />
		</footer>
	</body>
</html>
