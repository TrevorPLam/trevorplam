---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ErrorBoundary from '../components/ErrorBoundary.astro';

export interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogType?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = '/images/og-image.svg', ogType = 'website', jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.toString() || 'https://trevor-lam.com';

// Base JSON-LD structured data with Person and WebSite schemas
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Trevor Lam',
      url: siteUrl,
      sameAs: ['https://linkedin.com/in/trevor-lam'],
      jobTitle: 'Chief of Staff',
      description: 'Operations leader specializing in forensic stabilization and information architecture for multi-unit businesses.',
      knowsAbout: [
        'Operations Management',
        'Chief of Staff',
        'HR/Payroll Systems',
        'Business Process Optimization',
        'Information Architecture',
        'Crisis Management'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Chief of Staff Hub — Trevor Lam',
      author: { '@id': `${siteUrl}#person` },
      mainEntityOfPage: canonicalUrl.toString()
    }
  ]
};

// Merge additional JSON-LD if provided
const finalJsonLd = jsonLd
  ? (Array.isArray(jsonLd) ? { '@context': 'https://schema.org', '@graph': [...baseJsonLd['@graph'], ...jsonLd] } : jsonLd)
  : baseJsonLd;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL(ogImage, siteUrl)} />
		<meta property="og:site_name" content="Chief of Staff Hub — Trevor Lam" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

		<!-- Analytics: Plausible (Privacy-First) -->
		<link rel="dns-prefetch" href="https://plausible.io" />
		<script defer data-domain="trevor-lam.com" src="https://plausible.io/js/script.js"></script>

		<!-- Error Monitoring -->
		<script type="module" src="/src/utils/error-monitoring.ts"></script>

		<!-- Real User Monitoring -->
		<script type="module" src="/src/utils/rum-monitoring.ts"></script>

		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
	</head>
	<body class="bg-bg text-text-body">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-surface text-text-heading px-4 py-2 rounded border border-border">
			Skip to Content
		</a>
		<header>
			<Navigation />
		</header>
		<ErrorBoundary>
		<main id="main-content">
			<slot />
		</main>
	</ErrorBoundary>
		<footer aria-label="Site footer">
			<Footer />
		</footer>
	</body>
</html>
